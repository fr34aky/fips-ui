{
  "name": "fips-ui",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Web dashboard to watch and manage a FIPS mesh node",
  "engines": {
    "node": ">=22.18 <23 || >=23.6"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch server/index.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "node server/index.ts",
    "install:all": "npm --prefix web install",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "license": "MIT"
}
