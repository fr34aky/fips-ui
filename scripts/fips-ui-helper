#!/usr/bin/env bash
# fips-ui-helper — the only privileged part of the FIPS UI upgrade flow.
# Linux (systemd / OpenRC), macOS (launchd), FreeBSD (rc.d) and pfSense (its rc.d/*.sh boot scripts).
#
# Installed root-owned at /usr/local/libexec/fips-ui-helper and reachable by
# the UI user through a single NOPASSWD sudoers rule (deploy/sudoers.d/fips-ui).
# The web backend stages binaries (or a release .pkg) as an unprivileged user;
# this script does the root-only steps: back up, swap the binaries (or run the
# native package installer), restart the service.
#
# Commands:
#   check                          -> {"ok":true,"version":6,...}
#   install <stagedir> [--no-restart]
#   rollback <backup-id>
#   restart
#   list-backups
#   config-show [backup-id]        -> fips.yaml (or a config backup) with secret values redacted as
#                                     numbered placeholders bound to their key and parent line
#   config-apply [--no-restart] --base <sha256> <- new fips.yaml on stdin; redacted placeholders are restored from
#                                     the current file; backed up, installed, daemon restarted and
#                                     rolled back automatically if it does not come up healthy
#   config-backups                 -> JSON list of config backups
#   config-restore <backup-id>     -> reinstall a config backup, restart with the same health check
#   firewall-status                -> JSON: unit state, whether table inet fips is loaded, live ruleset
#   dropin-apply <name>            <- nftables drop-in on stdin; validated with `nft -c` against the
#                                     full baseline before /etc/fips/fips.d/<name>.nft is written
#   dropin-delete <name>
#   service <action> <unit>        -> start|stop|restart|reload|enable|disable for fips units (systemd)
#   mesh-guard <ports|off|status> [tun] [canary] -> load, remove or inspect table inet fips_ui_guard: TCP from fd00::/8 to the
#                                     web UI's ports is dropped unless it arrives on lo or the FIPS TUN, so
#                                     a mesh source address can be trusted as the npub it derives from
#   daemon-install [vX.Y.Z|""] [npub@udp|tcp/host:port]...
#                                  -> (v9) on a machine without fips: download the newest (or the given) official
#                                     release, verify it against its checksums file, install it, set a persistent
#                                     identity and the given bootstrap peers in fips.yaml, start it, and add the
#                                     calling UI user to the fips group
#   daemon-installed               -> (v9) exit 0 and print what was found if fips is installed, 1 if not
#   hosts-apply --base <sha256|none> <- new /etc/fips/hosts on stdin (hostname npub lines, comments); refused
#                                     if the file changed since it was read; backed up and replaced
#                                     atomically, root:root 0644 (the daemon reloads it on the next query)
#
# Environment overrides (also honoured under sudo only if the sudoers rule
# passes them; the defaults are chosen per OS):
#   FIPS_BIN_DIR, FIPS_UI_BACKUPS, FIPS_SERVICE, FIPS_GATEWAY_SERVICE
#
# Anyone allowed to run "install" can place arbitrary root binaries — that is
# inherent to what an upgrade is. Restrict the sudoers rule to the UI user.

set -euo pipefail
umask 022

HELPER_VERSION=10
OS=$(uname -s)
BINARIES=(fips fipsctl fipstop fips-gateway)

case "$OS" in
  Darwin)
    BIN_DIR_DEFAULT=/usr/local/bin
    BACKUPS_DEFAULT=/usr/local/var/fips-ui/backups
    SERVICE_DEFAULT=com.fips.daemon
    GATEWAY_DEFAULT=com.fips.gateway
    ;;
  FreeBSD)
    BIN_DIR_DEFAULT=/usr/local/bin
    BACKUPS_DEFAULT=/var/db/fips-ui/backups
    SERVICE_DEFAULT=fips
    GATEWAY_DEFAULT=fips_gateway
    ;;
  *)
    BIN_DIR_DEFAULT=/usr/bin
    [[ -x /usr/bin/fips || ! -x /usr/local/bin/fips ]] || BIN_DIR_DEFAULT=/usr/local/bin
    BACKUPS_DEFAULT=/var/lib/fips-ui/backups
    SERVICE_DEFAULT=fips
    GATEWAY_DEFAULT=fips-gateway
    ;;
esac

# NixOS: the system, fips included, is declared in the NixOS configuration (upstream's services.fips module, and
# fips-ui's own module, which installs this helper with its dependencies): binaries come from the Nix store, units
# cannot be enabled by hand, and fips.yaml lives in /var/lib/fips.
NIXOS=false; [[ -e /etc/NIXOS || ${FIPS_UI_NIXOS:-0} == 1 ]] && NIXOS=true
if $NIXOS && [[ -x /run/current-system/sw/bin/fips ]]; then BIN_DIR_DEFAULT=/run/current-system/sw/bin; fi
nix_managed() { $NIXOS && die "fips is managed by Nix on NixOS: update the fips flake input and run nixos-rebuild switch"; return 0; }

BIN_DIR=${FIPS_BIN_DIR:-$BIN_DIR_DEFAULT}
BACKUPS_DIR=${FIPS_UI_BACKUPS:-$BACKUPS_DEFAULT}
SERVICE=${FIPS_SERVICE:-$SERVICE_DEFAULT}
GATEWAY_SERVICE=${FIPS_GATEWAY_SERVICE:-$GATEWAY_DEFAULT}

log() { printf '%s\n' "$*" >&2; }
die() { log "error: $*"; exit 1; }
# Minimal JSON string escaper (no python dependency).
json_escape() {
  local s=$1
  s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; s=${s//$'\t'/\\t}; s=${s//$'\r'/}
  printf '"%s"' "$s"
}

# Root is required for real installs. FIPS_UI_HELPER_TEST=1 allows exercising
# the file logic as a normal user against a private FIPS_BIN_DIR with
# FIPS_SERVICE=none (used by the test suite; never set this in sudoers).
if [[ $(id -u) -ne 0 ]]; then
  [[ ${FIPS_UI_HELPER_TEST:-0} == 1 && -n ${FIPS_BIN_DIR:-} && ${FIPS_SERVICE:-} == none ]] || die "must run as root (via sudo)"
fi

# ---------------------------------------------------------------- service mgr
detect_service_manager() {
  if [[ "$OS" == Darwin ]]; then echo launchd
  # pfSense is FreeBSD underneath, but runs /usr/local/etc/rc.d/*.sh scripts itself instead of rc.conf services.
  elif [[ "$OS" == FreeBSD ]] && grep -qi pfsense /etc/platform 2>/dev/null; then echo pfsense
  elif [[ "$OS" == FreeBSD ]]; then echo rc
  elif command -v systemctl >/dev/null 2>&1 && [[ -d /run/systemd/system ]]; then echo systemd
  elif command -v rc-service >/dev/null 2>&1; then echo openrc
  elif [[ -x /etc/init.d/fips ]]; then echo sysv
  else echo none; fi
}
SM=$(detect_service_manager)
[[ "$SERVICE" == none ]] && SM=none

svc_exists() {
  case "$SM" in
    systemd) systemctl cat "$1" >/dev/null 2>&1 ;;
    launchd) launchctl print "system/$1" >/dev/null 2>&1 || [[ -f "/Library/LaunchDaemons/$1.plist" ]] ;;
    rc)      service "$1" onestatus >/dev/null 2>&1 || [[ -x "/usr/local/etc/rc.d/$1" ]] ;;
    pfsense) [[ -x "/usr/local/etc/rc.d/$1.sh" ]] ;;
    openrc)  rc-service -e "$1" ;;
    sysv)    [[ -x "/etc/init.d/$1" ]] ;;
    *) return 1 ;;
  esac
}
svc_active() {
  case "$SM" in
    systemd) systemctl is-active --quiet "$1" ;;
    launchd) launchctl print "system/$1" 2>/dev/null | grep -q 'state = running' ;;
    rc)      service "$1" onestatus >/dev/null 2>&1 ;;
    pfsense) "/usr/local/etc/rc.d/$1.sh" status >/dev/null 2>&1 ;;
    openrc)  rc-service "$1" status >/dev/null 2>&1 ;;
    sysv)    "/etc/init.d/$1" status >/dev/null 2>&1 ;;
    *) return 1 ;;
  esac
}
# rc.d scripts on FreeBSD and pfSense start fips under daemon(8) without detaching its stdout/stderr, so the
# supervisor would keep the caller's pipes open for good (the helper's $(...) and the UI's pipe then never see
# EOF). Their output goes to a file instead, and is passed on to stderr once the script returns.
rc_script() {
  local out rc
  out=$(mktemp)
  "$@" >"$out" 2>&1 </dev/null 9>&-; rc=$?
  [[ -s "$out" ]] && sed 's/^/  /' "$out" >&2
  rm -f "$out"
  return $rc
}
svc_start() {
  case "$SM" in
    systemd) systemctl start "$1" 9>&- ;;
    launchd) launchctl kickstart "system/$1" 9>&- ;;
    rc)      rc_script service "$1" onestart ;;
    pfsense) rc_script "/usr/local/etc/rc.d/$1.sh" start ;;
    openrc)  rc-service "$1" start 9>&- ;;
    *) return 1 ;;
  esac
}
svc_stop() {
  case "$SM" in
    systemd) systemctl stop "$1" ;;
    launchd) launchctl kill TERM "system/$1" ;;
    rc)      rc_script service "$1" onestop ;;
    pfsense) rc_script "/usr/local/etc/rc.d/$1.sh" stop ;;
    openrc)  rc-service "$1" stop ;;
    *) return 1 ;;
  esac
}
# Start at boot or not. pfSense runs every rc.d/*.sh at boot itself (its own knob lives in fips.conf).
svc_enable() { # <name> <true|false>
  $NIXOS && die "on NixOS, whether a unit starts at boot is set in the NixOS configuration"
  case "$SM" in
    systemd) if $2; then systemctl enable "$1"; else systemctl disable "$1"; fi ;;
    launchd) if $2; then launchctl enable "system/$1"; else launchctl disable "system/$1"; fi ;;
    rc)      sysrc -q "${1}_enable=$($2 && echo YES || echo NO)" >/dev/null ;;
    openrc)  if $2; then rc-update add "$1" default; else rc-update del "$1" default; fi ;;
    *) return 1 ;;
  esac
}
svc_enabled() {
  case "$SM" in
    systemd) systemctl is-enabled "$1" 2>/dev/null || true ;;
    launchd) launchctl print-disabled system 2>/dev/null | grep -q "\"$1\" => \(true\|disabled\)" && echo disabled || echo enabled ;;
    rc)      [[ "$(sysrc -n "${1}_enable" 2>/dev/null)" =~ ^[Yy][Ee][Ss]$ ]] && echo enabled || echo disabled ;;
    pfsense) echo enabled ;;
    openrc)  rc-update show default 2>/dev/null | grep -qw "$1" && echo enabled || echo disabled ;;
    *) echo unknown ;;
  esac
}
# The native service name for a fips unit id (fips, fips-dns, fips-gateway, fips-firewall), or nothing.
svc_native() {
  case "$SM:$1" in
    systemd:fips|systemd:fips-dns|systemd:fips-gateway|systemd:fips-firewall) echo "$1.service" ;;
    rc:fips|rc:fips-dns|rc:fips-gateway) echo "${1//-/_}" ;;
    pfsense:fips) echo fips ;;
    launchd:fips) echo "$SERVICE" ;;
    launchd:fips-gateway) echo "$GATEWAY_SERVICE" ;;
    openrc:fips|openrc:fips-dns|openrc:fips-gateway) echo "$1" ;;
  esac
}
# 9>&- : a daemon started by the service manager must not inherit the helper lock.
svc_restart() {
  case "$SM" in
    systemd) systemctl restart "$1" 9>&- ;;
    launchd) launchctl kickstart -k "system/$1" 9>&- ;;
    rc)      rc_script service "$1" onerestart ;;
    pfsense) rc_script "/usr/local/etc/rc.d/$1.sh" restart ;;
    openrc)  rc-service "$1" restart 9>&- ;;
    sysv)    "/etc/init.d/$1" restart 9>&- ;;
    *) return 1 ;;
  esac
}

restart_services() {
  local restarted=false
  if svc_exists "$SERVICE"; then
    log "restarting $SERVICE ($SM)"
    svc_restart "$SERVICE" && restarted=true
  else
    log "warning: service $SERVICE not found under $SM; not restarted"
  fi
  if svc_active "$GATEWAY_SERVICE"; then
    log "restarting $GATEWAY_SERVICE"
    svc_restart "$GATEWAY_SERVICE" || log "warning: $GATEWAY_SERVICE restart failed"
  fi
  printf '%s' "$restarted"
}

# ---------------------------------------------------------------- helpers
current_version() { "$BIN_DIR/fips" --version 2>/dev/null | head -n 1 || echo "unknown"; }
ensure_backups_dir() { mkdir -p "$BACKUPS_DIR"; chmod 0755 "$BACKUPS_DIR"; }
runs() { "$1" --version >/dev/null 2>&1; }   # portable "is this a working executable" (ELF or Mach-O)

do_backup() {
  ensure_backups_dir
  local ver id dir d
  ver=$(current_version | sed -E 's/^fips +//; s/[^A-Za-z0-9._-]+/_/g')
  id="$(date +%Y%m%d-%H%M%S)_${ver:-unknown}"
  dir="$BACKUPS_DIR/$id"
  local i=1; while [[ -e "$dir" ]]; do i=$((i + 1)); dir="$BACKUPS_DIR/${id}-$i"; done; id=$(basename "$dir")
  mkdir -p "$dir"
  for b in "${BINARIES[@]}"; do
    [[ -f "$BIN_DIR/$b" ]] && cp -p "$BIN_DIR/$b" "$dir/$b"
  done
  current_version > "$dir/VERSION"
  chmod -R a+rX "$dir"
  log "backed up current binaries to $dir"
  # keep the 10 most recent backups (portable: no xargs -r)
  local n=0
  for d in $(ls -1dt "$BACKUPS_DIR"/*/ 2>/dev/null); do
    n=$((n + 1)); [[ $n -gt 10 ]] && rm -rf -- "$d"
  done
  printf '%s' "$id"
}

install_binaries() {
  local src=$1 installed=() f
  for b in "${BINARIES[@]}"; do
    f="$src/$b"
    [[ -e "$f" ]] || continue
    [[ -L "$f" ]] && die "refusing symlink $f"
    [[ -f "$f" ]] || die "$f is not a regular file"
    runs "$f" || die "$f does not execute (--version failed)"
    if [[ $(id -u) -eq 0 ]]; then install -m 0755 -o 0 -g 0 "$f" "$BIN_DIR/.$b.new"; else install -m 0755 "$f" "$BIN_DIR/.$b.new"; fi
    mv -f "$BIN_DIR/.$b.new" "$BIN_DIR/$b"
    installed+=("$b")
  done
  [[ ${#installed[@]} -gt 0 ]] || die "nothing to install in $src"
  log "installed: ${installed[*]}"
}

install_package() {
  local pkg=$1
  case "$OS" in
    Darwin)  log "installer -pkg $pkg -target /"; installer -pkg "$pkg" -target / 9>&- ;;
    FreeBSD) log "pkg add -f $pkg"; pkg add -f "$pkg" 9>&- ;;
    *) die "package artifacts are not supported on $OS" ;;
  esac
}

# ---------------------------------------------------------------- node management (v4)
case "$OS" in
  FreeBSD|Darwin) FIPS_ETC=/usr/local/etc/fips ;;
  *)              FIPS_ETC=/etc/fips ;;
esac
FIPS_CONFIG=$FIPS_ETC/fips.yaml
# Upstream's NixOS module starts fips with --config /var/lib/fips/fips.yaml.
if $NIXOS && [[ -f /var/lib/fips/fips.yaml ]]; then FIPS_CONFIG=/var/lib/fips/fips.yaml; fi
FIPS_HOSTS=$FIPS_ETC/hosts
FIPS_NFT=/etc/fips/fips.nft
DROPIN_DIR=/etc/fips/fips.d
# pf (FreeBSD, macOS): drop-ins in pf.d are rendered, with the baseline, into one anchor file. FreeBSD references
# the anchors from a marked block in /etc/pf.conf; macOS loads them under Apple's existing "com.apple/*".
PF_DROPIN_DIR=$FIPS_ETC/pf.d
PF_FW_FILE=$FIPS_ETC/fips-ui-firewall.pf
PF_CONF=/etc/pf.conf
if [[ "$OS" == Darwin ]]; then PF_FW_ANCHOR=com.apple/fips-ui-firewall; PF_GUARD_ANCHOR=com.apple/fips-ui-guard; PF_REF='anchor "com.apple/\*"'
else PF_FW_ANCHOR=fips-ui/firewall; PF_GUARD_ANCHOR=fips-ui/guard; PF_REF='anchor "fips-ui/firewall"'; fi
PF_MARK_BEGIN='# >>> fips-ui: anchors of the fips firewall and the web UI guard (managed by fips-ui; keep these lines)'
PF_MARK_END='# <<< fips-ui'
# Fixed per OS and deliberately not derived from FIPS_UI_BACKUPS, which sudo forwards from the caller.
CONFIG_BACKUPS_DIR="$(dirname "$BACKUPS_DEFAULT")/config-backups"
LOCK_FILE=/var/run/fips-ui-helper.lock
MAX_CONFIG_BYTES=262144
MAX_DROPIN_BYTES=65536
MAX_HOSTS_BYTES=65536
# Keys whose values never leave this script, matched case-insensitively against the whole key.
SECRET_KEYS='nsec|control_auth|secret|secret_key|private_key|password|passphrase|token|api_key|auth_token|psk|preshared_key|mnemonic|seed'
# Test mode only (FIPS_UI_HELPER_TEST=1 is never forwarded by sudo, see deploy/sudoers.d/fips-ui): point the
# management verbs at scratch files so the whole flow can be exercised without touching /etc.
if [[ ${FIPS_UI_HELPER_TEST:-0} == 1 ]]; then
  FIPS_CONFIG=${FIPS_TEST_CONFIG:-$FIPS_CONFIG}; FIPS_NFT=${FIPS_TEST_NFT:-$FIPS_NFT}; DROPIN_DIR=${FIPS_TEST_DROPIN_DIR:-$DROPIN_DIR}
  CONFIG_BACKUPS_DIR=${FIPS_TEST_CONFIG_BACKUPS:-$CONFIG_BACKUPS_DIR}; LOCK_FILE=${FIPS_TEST_LOCK:-$LOCK_FILE}
  FIPS_HOSTS=${FIPS_TEST_HOSTS:-$FIPS_HOSTS}
fi

# One privileged change at a time, across every caller (UI, upgrade jobs, a second tab, a shell).
take_lock() {
  if command -v flock >/dev/null 2>&1; then
    exec 9>"$LOCK_FILE"
    flock -w 10 9 || die "another privileged operation is in progress"
    return 0
  fi
  # No flock (FreeBSD, macOS): a lock directory holding the owner's pid. A lock whose owner is gone is taken
  # over, so it needs no cleanup on exit (which the verbs' own EXIT traps would replace).
  # Stale only when its owner is known and gone (or is no longer this helper); a lock without a pid yet is being
  # taken right now and is waited for, unless it is older than 30 s.
  local d="$LOCK_FILE.d" i owner age
  for i in $(seq 1 50); do
    if mkdir "$d" 2>/dev/null; then echo $$ > "$d/pid.tmp" && mv -f "$d/pid.tmp" "$d/pid"; return 0; fi
    owner=$(cat "$d/pid" 2>/dev/null || true)
    if [[ -n "$owner" ]]; then
      if ! kill -0 "$owner" 2>/dev/null || ! ps -p "$owner" -o command= 2>/dev/null | grep -q fips-ui-helper; then rm -rf "$d"; continue; fi
    else
      age=$(( $(date +%s) - $(file_mtime "$d" 2>/dev/null || date +%s) ))
      (( age > 30 )) && { rm -rf "$d"; continue; }
    fi
    sleep 0.2
  done
  die "another privileged operation is in progress"
}

# Portable pieces: GNU coreutils on Linux, BSD tools on FreeBSD and macOS.
sha256_stdin() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum | cut -d' ' -f1
  elif command -v sha256 >/dev/null 2>&1; then sha256 -q
  else shasum -a 256 | cut -d' ' -f1; fi
}
file_mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1"; }
# "<octal mode> <uid> <gid>" of a file, to write its replacement with the same ones.
file_perms() { stat -c '%a %u %g' "$1" 2>/dev/null || stat -f '%Lp %u %g' "$1"; }
# Keep the newest <n> of the files matching a glob (no xargs -r, which BSD/macOS xargs may lack).
keep_newest() { # <n> <glob...>
  local n=$1 i=0 f; shift
  for f in $(ls -1t "$@" 2>/dev/null); do i=$((i + 1)); (( i > n )) && rm -f -- "$f"; done
  return 0
}

# Secret redaction, decided from the parsed YAML tree (PyYAML's safe composer), never from line text. Each
# secret key's value must be a single-line plain or quoted scalar with no anchor, tag or alias; its exact
# character span is replaced by "<redacted #N>". A comment that names a secret key, quotes a secret of 8+
# characters, or holds an nsec or 64-hex key (alone or wrapped over consecutive comment lines: every line
# holding part of it) is shown as "# <redacted comment #N>". A secret line commented out in the editor
# ('# nsec: "<redacted #1>"') gets its value back inside the comment, which then stays hidden. Anything else is refused (exit 3, reasons on stderr), and so is a file where a
# secret of 8+ characters also appears in another value (npub included), anchor, tag or directive (keys only
# as long copies), or an nsec or 64-hex value sits outside a secret key (hex public keys under npub are
# allowed). Shorter secrets are redacted in place only. Restore requires each placeholder to be a whole scalar
# value under the same key at the same path (and each comment placeholder a whole comment), puts the original
# text back, re-parses the result and checks each secret is exactly at its path, and that the result can be
# shown again with every restored comment still hidden. Runs as root in isolated mode (python3 -I): no user
# environment is consulted.
read -r -d '' REDACT_PY <<'PY' || true
# Secret redaction for fips.yaml, decided from the parsed YAML tree (PyYAML's safe composer), never from text.
#   redact <file>                     -> "base <sha256 of the bytes read>" line, then the file with each secret
#                                        value replaced by "<redacted #N>" (exit 3 + reasons if unsafe)
#   restore <original> <new> <out>    -> new file with each placeholder replaced by the original value text
# Files are handled as bytes decoded without newline translation, so line endings and trailing newlines are
# kept exactly; a leading UTF-8 BOM is kept aside (libyaml does not count it in its positions).
#
# Purpose: keep secret values off screens, out of the browser, logs and screenshots. It is NOT a boundary
# against someone allowed to edit fips.yaml: such a person can always make the daemon use a secret somewhere
# else (for example point the Tor control address at their own listener), which is why only admins may edit.
import hashlib, re, sys
try:
    import yaml
    from yaml import nodes
except ImportError:
    print('config editing needs python3 with PyYAML (Arch: python-yaml, Debian/Ubuntu: python3-yaml, Fedora: python3-pyyaml)', file=sys.stderr)
    sys.exit(3)

KEYS = set(k.lower() for k in sys.argv[2].split('|'))
MODE = sys.argv[1]
NSEC = re.compile(r'nsec1[02-9ac-hj-np-z]{6,}', re.I)
# In text with whitespace and '#' removed a key can touch hex letters of neighbouring words: any run of 64+.
HEXRUN = re.compile(r'[0-9a-fA-F]{64,}')
# Copies of a secret elsewhere in the file are detected for values of at least this many characters. Shorter
# ones ("tor", "control", "fips") are ordinary words of this configuration; they are redacted where they are
# set, but the same word elsewhere is not treated as a copy (that would lock the editor on normal files).
MIN_COPY = 8
# Keys whose value is a public key, which fips also accepts as 64 hex characters.
PUBLIC_KEYS = {'npub'}
NOT_SECRET = {'', 'null', '~', 'true', 'false', 'cookie'}
BOM = '\ufeff'
KEYED = re.compile(r'(?<![A-Za-z0-9_])[\'"]?(' + '|'.join(map(re.escape, sorted(KEYS))) + r')[\'"]?\s*[:=]', re.I)
# YAML 1.1 line breaks (libyaml); Python's str.splitlines also splits on \v, \f and others, which YAML does not.
BREAK = re.compile(r'\r\n|[\r\n\x85\u2028\u2029]')
RUN_GAP = re.compile('(?:' + BREAK.pattern + r')[ \t]*')
PLACEHOLDERS = re.compile(r'"<redacted #\d+>"|# <redacted comment #\d+>')
PH = re.compile(r'<redacted #(\d+)>')
COMMENTED = re.compile(r'^(#\s*(?:-\s+)?)([^:#"\']+|"[^"]*"|\'[^\']*\')\s*:\s*("<redacted #(\d+)>")\s*$')
CPH = re.compile(r'^#\s*<redacted comment #(\d+)>\s*$')
SAFE_TAGS = {'tag:yaml.org,2002:str', 'tag:yaml.org,2002:int', 'tag:yaml.org,2002:float', 'tag:yaml.org,2002:bool', 'tag:yaml.org,2002:null'}
Loader = getattr(yaml, 'CSafeLoader', yaml.SafeLoader)

class Refuse(Exception):
    pass

def line(n):
    return n.start_mark.line + 1

def read(path):
    data = open(path, 'rb').read()
    try:
        text = data.decode('utf-8')
    except UnicodeDecodeError:
        raise Refuse('the file is not UTF-8')
    bom = text.startswith(BOM)
    return data, (text[1:] if bom else text), (BOM if bom else '')

def compose(text, what):
    try:
        docs = list(yaml.compose_all(text, Loader=Loader))
    except yaml.YAMLError as e:
        raise Refuse(f'{what} is not valid YAML: {str(e).splitlines()[0]}')
    if len(docs) > 1:
        raise Refuse(f'{what} has more than one YAML document')
    return docs[0] if docs else None

def uses(root):
    """How often each node object is reachable (an alias makes it more than once). Cycle-safe."""
    counts = {}
    stack = [root] if root is not None else []
    while stack:
        n = stack.pop()
        counts[id(n)] = counts.get(id(n), 0) + 1
        if counts[id(n)] > 1:
            continue
        if isinstance(n, nodes.MappingNode):
            for k, v in n.value:
                stack.extend((k, v))
        elif isinstance(n, nodes.SequenceNode):
            stack.extend(n.value)
    return counts

def squash(s):
    """Text with whitespace and comment markers removed: how a value wrapped over lines or comments reads joined."""
    return re.sub(r'[\s#]+', '', s)

def key_material(s):
    """An nsec or a 64-hex key anywhere in s, even wrapped over several lines or next to other hex letters."""
    return squashed_key_material(squash(s))

def squashed_key_material(q):
    return bool(NSEC.search(q) or HEXRUN.search(q))

def check_stray(n):
    if key_material(n.value):
        raise Refuse(f'line {line(n)}: an nsec or 64-character hex value (possibly a private key) outside a secret key')

def secret_forms(value):
    """The strings whose presence elsewhere would reveal a secret: the value, and for Tor's "password:<pw>" the pw,
    each also without surrounding spaces."""
    forms = {value}
    if value.lower().startswith('password:'):
        forms.add(value.split(':', 1)[1])
    forms |= {f.strip() for f in forms}
    return {f for f in forms if f.strip().lower() not in NOT_SECRET and len(f.strip()) >= 3}

def secrets(text, root, public=None):
    """[(path, keyname, value node)] for every secret key; refuse any form that cannot be redacted exactly."""
    counts = uses(root)
    if any(c > 1 for c in counts.values()):
        raise Refuse('the file uses YAML aliases (*name), which this editor does not support')
    found, seen = [], set()
    def walk(n, path):
        if id(n) in seen:
            return
        seen.add(id(n))
        if isinstance(n, nodes.MappingNode):
            for k, v in n.value:
                if isinstance(k, nodes.ScalarNode):
                    check_stray(k)
                if not isinstance(k, nodes.ScalarNode):
                    if any(isinstance(x, nodes.ScalarNode) and x.value.strip().lower() in KEYS for x in flatten(k)):
                        raise Refuse(f'line {line(k)}: a secret key inside a complex mapping key')
                    walk(k, path + ['?']); walk(v, path + ['?'])
                    continue
                name = k.value.strip().lower()
                p = path + [k.value]
                if name in PUBLIC_KEYS and isinstance(v, nodes.ScalarNode):
                    # A public key may be hex; only an nsec there is refused.
                    if NSEC.search(squash(v.value)):
                        raise Refuse(f'line {line(v)}: an nsec value under {name}')
                    if public is not None:
                        public.append(v)
                    continue
                if name in KEYS:
                    if not isinstance(v, nodes.ScalarNode):
                        raise Refuse(f'line {line(v)}: {name} holds a list or mapping, not a single value')
                    if counts.get(id(v), 0) > 1 or counts.get(id(k), 0) > 1:
                        raise Refuse(f'line {line(v)}: {name} is used through a YAML alias')
                    if v.start_mark.line != v.end_mark.line:
                        raise Refuse(f'line {line(v)}: {name} spans several lines')
                    if v.style in ('|', '>'):
                        raise Refuse(f'line {line(v)}: {name} is a block scalar')
                    if v.tag not in SAFE_TAGS or text[v.start_mark.index:v.start_mark.index + 1] in ('&', '!', '*'):
                        raise Refuse(f'line {line(v)}: {name} has an anchor or tag')
                    if v.tag != 'tag:yaml.org,2002:null' and v.value != '':
                        # The replaced characters must be exactly this value (guards against any position drift).
                        snippet = text[v.start_mark.index:v.end_mark.index]
                        try:
                            back = yaml.compose(snippet, Loader=Loader)
                        except yaml.YAMLError:
                            back = None
                        if not isinstance(back, nodes.ScalarNode) or back.value != v.value:
                            raise Refuse(f'line {line(v)}: could not locate the exact value of {name}')
                        found.append((p, name, v))
                    continue
                walk(v, p)
        elif isinstance(n, nodes.SequenceNode):
            for v, sig in zip(n.value, sigs(n)):
                walk(v, path + [sig])
        elif isinstance(n, nodes.ScalarNode):
            check_stray(n)
    if root is not None:
        walk(root, [])
    return found

ID_KEYS = ('npub', 'alias', 'name', 'id')

def itemsig(v, i):
    """A list item's identity: its npub, alias, name or id if it has one (so editing its other fields, or deleting
    and reordering other items, keeps it), else its position."""
    if isinstance(v, nodes.MappingNode):
        for idk in ID_KEYS:
            for k, x in v.value:
                if isinstance(k, nodes.ScalarNode) and isinstance(x, nodes.ScalarNode) and k.value == idk and x.value:
                    return ('item', ((idk, x.value),))
    return i

def sigs(seq):
    """Signatures of a sequence's items, with an ordinal added where two items would otherwise collide."""
    seen, out = {}, []
    for i, v in enumerate(seq.value):
        sig = itemsig(v, i)
        n = seen.get(sig, 0); seen[sig] = n + 1
        out.append(sig if n == 0 else (sig, n))
    return out

def flatten(n, seen=None):
    seen = seen if seen is not None else set()
    if id(n) in seen:
        return
    seen.add(id(n))
    yield n
    if isinstance(n, nodes.MappingNode):
        for k, v in n.value:
            yield from flatten(k, seen); yield from flatten(v, seen)
    elif isinstance(n, nodes.SequenceNode):
        for v in n.value:
            yield from flatten(v, seen)

def splice(text, edits):
    for start, end, repl in sorted(edits, reverse=True):
        text = text[:start] + repl + text[end:]
    return text

def ph(i):
    return f'"<redacted #{i}>"'

def fmt(path):
    def one(x):
        if isinstance(x, tuple) and len(x) == 2 and isinstance(x[1], int) and isinstance(x[0], tuple):
            return one(x[0]) + f'#{x[1] + 1}'
        if isinstance(x, tuple) and x and x[0] == 'item':
            return '[' + ', '.join(f'{k}={v}' for k, v in x[1]) + ']'
        return str(x)
    return '.'.join(one(x) for x in path) or 'the top level'

def scan(text):
    """-> (comment spans, names). A comment starts at any '#' outside every token (libyaml starts one at any such
    '#') and runs to the end of the line. A block scalar's token also spans its header line ("key: | # note"),
    whose comment is not content, so that line is not treated as covered. Names are the decoded values of every
    token that is not a scalar (anchors, tags, %TAG and %YAML directives): text that is neither value nor comment."""
    import bisect
    cov, names = [], []
    try:
        for t in yaml.scan(text, Loader=Loader):
            v = getattr(t, 'value', None)
            if v is not None and not isinstance(t, yaml.ScalarToken):
                names.append(''.join(str(x) for x in v if x is not None) if isinstance(v, tuple) else str(v))
            a, b = t.start_mark.index, t.end_mark.index
            if b <= a:
                continue
            if getattr(t, 'style', None) in ('|', '>'):
                m = BREAK.search(text, a)
                a = b if not m or m.start() >= b else m.start()
            if b > a:
                cov.append((a, b))
        cov.sort()
    except yaml.YAMLError as e:
        raise Refuse(f'not valid YAML: {str(e).splitlines()[0]}')
    starts = [a for a, _ in cov]
    def covered(i):
        k = bisect.bisect_right(starts, i) - 1
        return k >= 0 and cov[k][0] <= i < cov[k][1]
    out, pos = [], 0
    for m in list(BREAK.finditer(text)) + [None]:
        end = m.start() if m else len(text)
        for i in range(pos, end):
            if text[i] == '#' and not covered(i):
                out.append((i, end))
                break
        pos = m.end() if m else end
    return out, names

def comment_runs(text, spans):
    """Comments on consecutive lines, grouped (a key or password wrapped over several comment lines)."""
    runs = []
    for a, b in spans:
        # Consecutive: only one line break and indentation between the previous comment's end and this '#'.
        if runs and RUN_GAP.fullmatch(text[runs[-1][-1][1]:a]):
            runs[-1].append((a, b))
        else:
            runs.append([(a, b)])
    return runs

def sensitive_comment(c, forms):
    """A single comment that names a secret key or quotes a secret form. Key material and wrapped forms are found by
    hidden_windows, which also covers single lines."""
    return bool(KEYED.search(c) or any(f in c for f, _ in forms))

def copy_forms(forms):
    """[(form, squashed form or '')] for the forms of at least MIN_COPY characters; the squashed form (for copies
    wrapped over lines) only where it is itself that long."""
    out = []
    for f in forms:
        if len(f.strip()) >= MIN_COPY:
            q = squash(f)
            out.append((f, q if len(q) >= MIN_COPY else ''))
    return out

def hidden_windows(text, run, forms):
    """Lines of a comment run that reveal key material or a secret only when joined (a key wrapped over lines).
    The squashed lines are joined once and searched; every line a match touches is hidden, so a greedy nsec match
    covers all of a wrapped key even when its first line is sensitive on its own. Linear in the run's length."""
    joined, owner = [], []
    for k, (a, b) in enumerate(run):
        q = squash(text[a:b])
        joined.append(q); owner.extend([k] * len(q))
    q = ''.join(joined)
    hits = set()
    # (start, end, characters a whole key needs: 63 for a bech32 nsec, 64 for hex, 0 for an exact secret form)
    matches = [(m.start(), m.end(), need) for rx, need in ((NSEC, 63), (HEXRUN, 64)) for m in rx.finditer(q)]
    for _, s in forms:
        if not s:
            continue
        start = q.find(s)
        while start >= 0:
            matches.append((start, start + len(s), 0))
            start = q.find(s, start + 1)
    # A greedy match can run into a neighbouring line whose words happen to be hex or bech32 letters ("# added a
    # new one"). An edge line stays visible when the rest of the match still holds a whole key without it.
    for a, b, need in matches:
        lines = owner[a:b]
        keep = set(lines)
        left = len(lines)
        if need and lines[0] != lines[-1]:
            for edge in (lines[-1], lines[0]):
                c = lines.count(edge)
                if left - c >= need:
                    keep.discard(edge); left -= c
        hits.update(keep)
    return [run[k] for k in sorted(hits)]

def redact_text(text):
    """-> (redacted text, secrets found, original texts of the redacted comments). Raises Refuse if unsafe."""
    if PH.search(text) or re.search(r'<redacted comment #', text):
        raise Refuse('the file already contains a redaction placeholder')
    root = compose(text, 'the file')
    public = []
    found = secrets(text, root, public)
    # Per secret: its decoded forms, and those plus its raw spellings (escapes, quotes) as they appear in the text.
    decoded, spelled = [], []
    for _, _, v in found:
        f = secret_forms(v.value)
        raw = text[v.start_mark.index:v.end_mark.index]
        decoded.append(f)
        spelled.append(f | {x for x in (raw, raw.strip('"\'')) if len(x) >= 3} if f else set())
    forms_all = copy_forms(set().union(*spelled)) if spelled else []
    edits = [(v.start_mark.index, v.end_mark.index, ph(i + 1)) for i, (_, _, v) in enumerate(found)]
    spans, names = scan(text)
    hide = {s for s in spans if sensitive_comment(text[s[0]:s[1]], forms_all)}
    # A key or password wrapped over consecutive comment lines: hide the lines that are sensitive only together
    # (just those, so documentation around them stays visible).
    for run in comment_runs(text, spans):
        hide.update(hidden_windows(text, run, forms_all))
    comments = []
    for a, b in spans:
        if (a, b) in hide:
            comments.append(text[a:b])
            edits.append((a, b, f'# <redacted comment #{len(comments)}>'))
    out = splice(text, edits)
    # Outside comments (hidden above) a secret may not appear anywhere: other values, raw spellings, anchor, tag
    # and directive names. Keys are the configuration's own vocabulary (a password "control" is not revealed by
    # the key control_auth), so a key only counts when it is a long copy (12+ characters).
    secret_ids = {id(v) for _, _, v in found}
    scalars = [x for x in flatten(root) if isinstance(x, nodes.ScalarNode) and id(x) not in secret_ids] if root is not None else []
    keys = {id(k) for n in flatten(root) if isinstance(n, nodes.MappingNode) for k, _ in n.value} if root is not None else set()
    # Public keys (npub) are exempt from the stray-key check, not from the copy check.
    values = [(x.value, squash(x.value)) for x in scalars if id(x) not in keys]
    keytexts = [x for x in scalars if id(x) in keys]
    # Raw text without placeholders and keys (whose spans shift by the same edits: blank them before redacting).
    blank = splice(text, [(x.start_mark.index, x.end_mark.index, ' ' * (x.end_mark.index - x.start_mark.index)) for x in keytexts + public])
    bare = PLACEHOLDERS.sub('', splice(blank, edits))
    qbare = squash(bare)
    for (_, name, v), mine, spell in zip(found, decoded, spelled):
        mine, spell = copy_forms(mine), copy_forms(spell)
        if (any(f in x or (sq and sq in qx) for f, sq in mine for x, qx in values)
                or any(len(f) >= 12 and f in x.value for f, _ in mine for x in keytexts)
                or any(f in n for f, _ in spell for n in names)
                or any(f in bare or (sq and sq in qbare) for f, sq in spell)):
            raise Refuse(f'the value of {name} also appears elsewhere in the file (another value, anchor or tag)')
    if key_material(bare):
        raise Refuse('an nsec or 64-character hex value (possibly a private key) appears outside a secret key')
    return out, found, comments

def redact(path):
    data, text, bom = read(path)
    out, _, _ = redact_text(text)
    return 'base ' + hashlib.sha256(data).hexdigest() + '\n' + bom + out

def socket_path(path):
    """node.control.socket_path from the parsed file, or '' (used by the helper's health check)."""
    _, text, _ = read(path)
    try:
        d = yaml.load(text, Loader=Loader)
        ctl = d.get('node', {}).get('control', {}) if isinstance(d, dict) else {}
        if isinstance(ctl, dict) and ctl.get('enabled') is False:
            return '-'
        v = ctl.get('socket_path') if isinstance(ctl, dict) else None
    except Exception:
        v = None
    return v if isinstance(v, str) and v.startswith('/') else ''

def get(root, path):
    n = root
    for p in path:
        if isinstance(n, nodes.MappingNode) and isinstance(p, str):
            n = next((v for k, v in n.value if isinstance(k, nodes.ScalarNode) and k.value == p), None)
        elif isinstance(n, nodes.SequenceNode):
            n = next((v for v, sig in zip(n.value, sigs(n)) if sig == p), None)
        else:
            return None
        if n is None:
            return None
    return n

def restore(orig_path, new_path, base):
    odata, otext, _ = read(orig_path)
    if hashlib.sha256(odata).hexdigest() != base:
        raise Refuse('fips.yaml changed since you loaded it; reload the page and make your edit again')
    _, orig, ocomments = redact_text(otext)
    _, ntext, nbom = read(new_path)
    # Browsers submit LF; keep a CRLF file CRLF.
    if '\r\n' in otext and '\r\n' not in ntext:
        ntext = ntext.replace('\n', '\r\n')
    nroot = compose(ntext, 'the new file')
    if any(c > 1 for c in uses(nroot).values()):
        raise Refuse('the new file uses YAML aliases (*name), which this editor does not support')
    edits, used = [], set()
    placeholder_nodes = 0
    def walk(n, path, key, seen):
        nonlocal placeholder_nodes
        if id(n) in seen:
            return
        seen.add(id(n))
        if isinstance(n, nodes.MappingNode):
            for k, v in n.value:
                if isinstance(k, nodes.ScalarNode) and PH.search(k.value):
                    raise Refuse(f'line {line(k)}: a redaction placeholder used as a key')
                walk(v, path + [k.value if isinstance(k, nodes.ScalarNode) else '?'], k, seen)
        elif isinstance(n, nodes.SequenceNode):
            for v, sig in zip(n.value, sigs(n)):
                walk(v, path + [sig], None, seen)
        elif isinstance(n, nodes.ScalarNode):
            m = PH.fullmatch(n.value)
            if not m:
                return
            placeholder_nodes += 1
            i = int(m.group(1))
            if i < 1 or i > len(orig):
                raise Refuse(f'line {line(n)}: placeholder #{i} does not exist')
            if i in used:
                raise Refuse(f'line {line(n)}: placeholder #{i} is used twice')
            opath, oname, ov = orig[i - 1]
            if path != opath or key is None or key.value.strip().lower() != oname:
                raise Refuse(f'line {line(n)}: redacted secret #{i} ({oname}) must stay at {fmt(opath)}')
            if n.start_mark.line != n.end_mark.line:
                raise Refuse(f'line {line(n)}: placeholder #{i} must stay a single-line value')
            used.add(i)
            edits.append((n.start_mark.index, n.end_mark.index, otext[ov.start_mark.index:ov.end_mark.index]))
    if nroot is not None:
        walk(nroot, [], None, set())
    if len(PH.findall(ntext)) != placeholder_nodes + sum(1 for a, b in scan(ntext)[0] if COMMENTED.match(ntext[a:b])):
        raise Refuse('a redaction placeholder appears somewhere other than as a whole value (a comment, key or longer string)')
    cused, cfound = set(), 0
    for a, b in scan(ntext)[0]:
        # A secret line commented out ('# nsec: "<redacted #1>"'): its value is put back inside the comment, which
        # names the secret key and so stays hidden.
        cm = COMMENTED.match(ntext[a:b])
        if cm:
            i = int(cm.group(4))
            if i < 1 or i > len(orig) or cm.group(2).strip('\'"').strip().lower() != orig[i - 1][1]:
                raise Refuse(f'a commented-out placeholder #{i} must stay under its own key ({orig[i - 1][1] if 0 < i <= len(orig) else "unknown"})')
            ov = orig[i - 1][2]
            edits.append((a + cm.start(3), a + cm.end(3), otext[ov.start_mark.index:ov.end_mark.index]))
            continue
        m = CPH.match(ntext[a:b])
        if not m:
            continue
        cfound += 1
        j = int(m.group(1))
        if j < 1 or j > len(ocomments) or j in cused:
            raise Refuse(f'comment placeholder #{j} does not exist or is used twice')
        cused.add(j)
        edits.append((a, b, ocomments[j - 1]))
    if len(re.findall(r'<redacted comment #', ntext)) != cfound:
        raise Refuse('a comment placeholder appears somewhere other than as a whole comment')
    out = splice(ntext, edits)
    # Re-parse: every restored secret must be exactly the original value at its original path, and nowhere else.
    root = compose(out, 'the result')
    for i in used:
        opath, oname, ov = orig[i - 1]
        n = get(root, opath)
        if not isinstance(n, nodes.ScalarNode) or n.value != ov.value:
            raise Refuse(f'redacted secret #{i} ({oname}) would not end up at {fmt(opath)} with its value')
    # Never save something the editor could not show again (that would lock the Configuration page); this also
    # refuses a restored secret that would appear anywhere else.
    try:
        _, _, now_comments = redact_text(out)
    except Refuse as e:
        raise Refuse(f'this change would leave a file the editor cannot show: {e}')
    # Every restored hidden comment must still be hidden in the result (it would show if it quotes a secret that
    # was changed or removed).
    for j in sorted(cused):
        if ocomments[j - 1] not in now_comments:
            raise Refuse(f'hidden comment #{j} would become visible: it is hidden because of a secret or key text, alone or '
                         f'together with the comment lines next to it. Keep those secrets and keep hidden comment lines together '
                         f'(add new lines above or below them), or delete the hidden comment lines')
    return nbom + out

try:
    if MODE == 'redact':
        sys.stdout.buffer.write(redact(sys.argv[3]).encode('utf-8'))
    elif MODE == 'socketpath':
        sys.stdout.write(socket_path(sys.argv[3]))
    elif MODE == 'restore':
        with open(sys.argv[5], 'wb') as f:
            f.write(restore(sys.argv[3], sys.argv[4], sys.argv[6]).encode('utf-8'))
    else:
        raise Refuse('unknown mode')
except Refuse as e:
    print(str(e), file=sys.stderr)
    sys.exit(3)
except (OSError, UnicodeDecodeError) as e:
    print(f'cannot read the file: {e}', file=sys.stderr)
    sys.exit(3)
PY
redact() { python3 -I -c "$REDACT_PY" redact "$SECRET_KEYS" "$1"; }
restore_secrets() { python3 -I -c "$REDACT_PY" restore "$SECRET_KEYS" "$1" "$2" "$3" "$4"; }

read_stdin_limited() { # <dest> <max-bytes>
  head -c "$(( $2 + 1 ))" > "$1"
  local n; n=$(wc -c < "$1" | tr -d ' ')
  (( n <= $2 )) || die "input larger than $2 bytes"
  (( n > 0 )) || die "empty input"
}

# The daemon's last log lines since <epoch>: the journal under systemd, its log file elsewhere.
journal_tail_json() { # <unit> <since-epoch>
  local out=""
  if [[ "$SM" == systemd ]]; then out=$(journalctl -u "$1" --since "@$2" -n 25 --no-pager -o cat 2>/dev/null || true)
  else
    local f
    for f in "$(sysrc -n fips_logfile 2>/dev/null || true)" /var/log/fips.log /var/log/fips/fips.log /usr/local/var/log/fips/fips.log; do
      [[ -n "$f" && -f "$f" ]] && { out=$(tail -n 25 "$f" 2>/dev/null || true); break; }
    done
  fi
  json_escape "$out"
}

fipsctl_bin() { [[ -x "$BIN_DIR/fipsctl" ]] && echo "$BIN_DIR/fipsctl" || echo fipsctl; }

# Healthy = the unit stays active without systemd restarting it, and the control socket (at the path the new
# config sets, if any) answers, for 8 consecutive seconds within a 45 s budget.
wait_fips_healthy() {
  local deadline=$(( $(date +%s) + 45 )) ok=0 restarts sock args=()
  # node.control.socket_path from the parsed file (any YAML style); other sections have their own socket_path.
  sock=$(python3 -I -c "$REDACT_PY" socketpath "$SECRET_KEYS" "$FIPS_CONFIG" 2>/dev/null || true)
  [[ -n "$sock" && "$sock" == /* ]] && args=(-s "$sock")
  # With the control socket disabled (node.control.enabled: false) only "active without restarts" can be checked.
  local probe=true; [[ "$sock" == "-" ]] && probe=false
  sleep 3
  # "Did it restart?": systemd counts restarts; elsewhere the daemon's pid must stay the same.
  restart_marker() {
    if [[ "$SM" == systemd ]]; then systemctl show -p NRestarts --value "$SERVICE" 2>/dev/null || echo 0
    else "$(fipsctl_bin)" ${args[@]+"${args[@]}"} show status 2>/dev/null | python3 -I -c 'import json,sys; print(json.load(sys.stdin).get("pid",""))' 2>/dev/null || echo ""; fi
  }
  restarts=$(restart_marker)
  while (( $(date +%s) < deadline )); do
    if svc_active "$SERVICE" && [[ "$(restart_marker)" == "$restarts" ]] \
       && { ! $probe || "$(fipsctl_bin)" ${args[@]+"${args[@]}"} show status >/dev/null 2>&1; }; then
      ok=$((ok + 1)); (( ok >= 8 )) && return 0
    else
      ok=0; restarts=$(restart_marker)
    fi
    sleep 1
  done
  return 1
}

require_systemd() { [[ "$SM" == systemd ]] || die "this needs systemd (found $SM)"; }
# Configuration, hosts file and services: every service manager whose restart and health the helper handles.
require_managed() { case "$SM" in systemd|rc|pfsense|launchd) ;; *) die "node management is not supported with $SM" ;; esac; }
valid_id() { [[ "$1" =~ ^[0-9]{8}-[0-9]{6}(-[0-9]+)?$ ]] || die "invalid backup id"; }

# backup_config [keep-id]: never prunes <keep-id> (the backup about to be restored).
backup_config() {
  mkdir -p "$CONFIG_BACKUPS_DIR"; chmod 0700 "$CONFIG_BACKUPS_DIR"
  local id; id=$(date +%Y%m%d-%H%M%S); local f="$CONFIG_BACKUPS_DIR/$id.yaml" i=1
  while [[ -e "$f" ]]; do i=$((i + 1)); f="$CONFIG_BACKUPS_DIR/$id-$i.yaml"; done
  install -m 0600 -o 0 -g 0 "$FIPS_CONFIG" "$f"
  local d n=0; for d in $(ls -1t "$CONFIG_BACKUPS_DIR"/*.yaml 2>/dev/null); do
    n=$((n + 1)); (( n > 20 )) && [[ "$(basename "$d" .yaml)" != "${1:-}" ]] && rm -f -- "$d"
  done
  basename "$f" .yaml
}

# install_config_and_restart <file> <backup-id> <restart:true|false>
# Signals are ignored from here on: a client that gives up must not interrupt an install or a rollback.
# Replace fips.yaml atomically: a temp file in the same directory, then rename (never a half-written file).
put_config() {
  # 0600 (it holds secrets); owner and group stay as they were (root:root when there is no file). On NixOS the mode
  # stays too: upstream's module keeps the file group-writable for the fips group on purpose.
  local m u=0 g=0 mode=0600
  [[ -f "$FIPS_CONFIG" ]] && read -r m u g < <(file_perms "$FIPS_CONFIG")
  $NIXOS && [[ -n "${m:-}" ]] && mode=$m
  install -m "$mode" -o "$u" -g "$g" "$1" "$FIPS_CONFIG.fips-ui.new" && mv -f "$FIPS_CONFIG.fips-ui.new" "$FIPS_CONFIG"
}

install_config_and_restart() {
  trap '' INT TERM HUP
  put_config "$1"
  if [[ "$3" != true ]]; then printf '{"ok":true,"changed":true,"backup_id":%s,"restarted":false}\n' "$(json_escape "$2")"; return; fi
  local start; start=$(date +%s)
  svc_restart "$SERVICE" || true
  if wait_fips_healthy; then
    printf '{"ok":true,"changed":true,"backup_id":%s,"restarted":true}\n' "$(json_escape "$2")"; return
  fi
  local log; log=$(journal_tail_json "$SERVICE" "$start")
  log "daemon unhealthy with the new config; restoring backup $2"
  put_config "$CONFIG_BACKUPS_DIR/$2.yaml"
  svc_restart "$SERVICE" || true
  local back=false; wait_fips_healthy && back=true
  printf '{"ok":false,"changed":false,"rolled_back":true,"backup_id":%s,"restored_healthy":%s,"error":"the daemon did not stay up with the new configuration","journal":%s}\n' "$(json_escape "$2")" "$back" "$log"
}

valid_dropin() { [[ "$1" =~ ^[a-z0-9][a-z0-9_-]{0,40}$ ]] || die "invalid drop-in name (a-z, 0-9, _ and -, up to 41 characters)"; }

# A drop-in is included inside the `inbound` chain, so it may only hold rule statements: no include/define
# (which could read other files), no table or chain commands, no `;`, and braces balanced on every line
# (so it cannot close the chain and act on the rest of the host's ruleset).
check_dropin_content() {
  awk '
    { line = $0; t = line; gsub(/"[^"]*"/, "\"\"", t); sub(/#.*/, "", t); gsub(/^[ \t]+|[ \t]+$/, "", t)
      if (t == "") next
      split(t, w, /[ \t]+/); first = tolower(w[1])
      if (first ~ /^(include|define|redefine|undefine|table|chain|flush|delete|add|create|insert|replace|reset|list|rename|monitor|export|import|describe|flowtable|destroy)$/) { printf "line %d: \"%s\" is not allowed in a drop-in\n", NR, w[1]; bad = 1; next }
      if (t ~ /[;$]/) { printf "line %d: \";\" and \"$\" are not allowed in a drop-in\n", NR; bad = 1; next }
      d = 0; for (i = 1; i <= length(t); i++) { ch = substr(t, i, 1); if (ch == "{") d++; else if (ch == "}") { d--; if (d < 0) break } }
      if (d != 0) { printf "line %d: braces must balance within the line\n", NR; bad = 1 }
    }
    END { exit bad }' "$1"
}

# check_ruleset <dir-with-candidate-dropins>: validate the baseline plus drop-ins without loading anything.
# Only nft's error summaries are returned (never the echoed source lines).
check_ruleset() {
  local t; t=$(mktemp -d); cp -a "$1/." "$t/" 2>/dev/null || true
  sed "s#include \"$DROPIN_DIR/\*\.nft\"#include \"$t/*.nft\"#" "$FIPS_NFT" > "$t/.baseline"
  grep -qF "include \"$t/*.nft\"" "$t/.baseline" || { rm -rf "$t"; printf '%s' "$FIPS_NFT does not contain the standard include \"$DROPIN_DIR/*.nft\" line; refusing to validate"; return 1; }
  local out; out=$(nft -c -f "$t/.baseline" 2>&1); local rc=$?
  rm -rf "$t"
  printf '%s' "$out" | grep -E 'Error:' | sed -E "s#^.*/([a-z0-9_-]+\.nft|\.baseline):#\1:#" | head -n 20
  return $rc
}

firewall_reload_if_active() {
  if systemctl is-active --quiet fips-firewall.service; then systemctl reload-or-restart fips-firewall.service && echo true || echo false; else echo false; fi
}

# ---------------------------------------------------------------- firewall backends
# nft: Linux with systemd (fips-firewall.service, table inet fips). pf: FreeBSD and macOS; not pfSense, which
# owns pf and regenerates its rules.
fw_backend() {
  # NixOS declares its firewall (and upstream's module ships no fips-firewall unit): not managed here.
  if $NIXOS; then echo none
  elif [[ "$SM" == systemd ]] && command -v nft >/dev/null 2>&1; then echo nft
  elif [[ "$OS" == FreeBSD && "$SM" != pfsense || "$OS" == Darwin ]] && command -v pfctl >/dev/null 2>&1; then echo pf
  else echo none; fi
}
guard_backend() {
  if [[ "$OS" == Linux ]] && command -v nft >/dev/null 2>&1; then echo nft
  elif [[ "$(fw_backend)" == pf ]]; then echo pf
  else echo none; fi
}
require_fw() { [[ "$(fw_backend)" == "$1" ]] || die "the fips firewall is not managed with $1 on this system"; }

pf_ready() { [[ "$OS" == FreeBSD ]] && kldload -n pf 2>/dev/null; return 0; }
# pfctl with its own exit status; its output goes to stderr without the "No ALTQ support" notices.
pfctl_run() {
  local out rc=0
  out=$(pfctl "$@" 2>&1) || rc=$?
  out=$(grep -v 'ALTQ' <<<"$out" || true)
  [[ -n "$out" ]] && printf '%s\n' "$out" >&2
  return $rc
}
pf_enabled() { pfctl -s info 2>/dev/null | grep -q 'Status: Enabled'; }
# The main ruleset evaluates our anchors (FreeBSD: the pf.conf block; macOS: Apple's com.apple/* anchor).
pf_referenced() { pfctl -s rules 2>/dev/null | grep -q "^$PF_REF"; }
# The guard only protects if pf evaluates it before every rule that could pass a packet: it must be the first
# filter rule (FreeBSD: our own reference inserted at the top; macOS: Apple's com.apple/* anchor).
pf_guard_first() {
  local first; first=$(pfctl -s rules 2>/dev/null | grep -v '^[[:space:]]' | head -n 1)
  if [[ "$OS" == Darwin ]]; then [[ "$first" == 'anchor "com.apple/*"'* ]]; else [[ "$first" == "anchor \"$PF_GUARD_ANCHOR\""* ]]; fi
}
# "set skip on lo0" makes pf ignore loopback, and with it the guard's canary.
pf_lo_skipped() { pfctl -s Interfaces -i lo0 -v 2>/dev/null | grep -q '(skip)'; }
pf_conf_has_block() { [[ -f "$PF_CONF" ]] && grep -qF "$PF_MARK_BEGIN" "$PF_CONF"; }
# The FIPS interface, from the daemon (tun0 on FreeBSD, utunN on macOS).
pf_tun() {
  local sock args=() t
  sock=$(python3 -I -c "$REDACT_PY" socketpath "$SECRET_KEYS" "$FIPS_CONFIG" 2>/dev/null || true)
  [[ -n "$sock" && "$sock" == /* ]] && args=(-s "$sock")
  t=$("$(fipsctl_bin)" ${args[@]+"${args[@]}"} show status 2>/dev/null | python3 -I -c 'import json,sys; print(json.load(sys.stdin).get("tun_name",""))' 2>/dev/null || true)
  [[ "$t" =~ ^[A-Za-z0-9_.-]{1,15}$ ]] || return 1
  echo "$t"
}
# The interface the loaded firewall anchor filters (from its rules), or nothing.
pf_anchor_tun() { pfctl -a "$PF_FW_ANCHOR" -s rules 2>/dev/null | sed -nE 's/^block drop in on ([A-Za-z0-9_.-]+) .*label "fips-ui drop".*/\1/p' | head -n 1; }

# pf_render_firewall <dropin-dir> <out>: the anchor's rules. Default deny for connections arriving on the FIPS
# interface, established ones and pings allowed, then the drop-ins (pass rules; pf uses the last match).
pf_render_firewall() {
  # Never guess the interface: rules for the wrong one would look loaded but protect nothing.
  local tun; tun=$(pf_tun) || die "cannot ask the fips daemon for its interface; is fips running?"
  {
    echo "# Generated by fips-ui-helper from $PF_DROPIN_DIR; rewritten on every change."
    echo "tun = \"$tun\""
    echo 'pass out on $tun all keep state'
    echo 'block drop in on $tun all label "fips-ui drop"'
    echo 'pass in on $tun inet6 proto icmp6 icmp6-type echoreq keep state'
    local f
    for f in "$1"/*.pf; do if [[ -f "$f" ]]; then echo "# --- $(basename "$f")"; cat "$f"; echo; fi; done
  } > "$2"
}

# A pf drop-in may hold only inbound pass/block rules on the FIPS interface ($tun): it cannot touch other
# interfaces, load files, define anchors or tables, or redirect traffic.
pf_check_dropin_content() {
  awk '
    { if ($0 ~ /\047/) { printf "line %d: single quotes are not allowed in a drop-in (use double quotes)\n", NR; bad = 1; next }
      q = $0; if (gsub(/"/, "", q) % 2) { printf "line %d: every double quote must be closed on its line\n", NR; bad = 1; next }
      t = $0; gsub(/"[^"]*"/, "\"\"", t); sub(/#.*/, "", t); gsub(/^[ \t]+|[ \t]+$/, "", t)
      if (t == "") next
      if (t !~ /^(pass|block)([ \t]+(drop|return|return-rst))?[ \t]+in([ \t]+log)?([ \t]+quick)?[ \t]+on[ \t]+\$tun([ \t]|$)/) { printf "line %d: every rule must start with \"pass in on $tun\" or \"block in on $tun\"\n", NR; bad = 1; next }
      if (t ~ /[\\;<>]/) { printf "line %d: \\, ;, < and > are not allowed in a drop-in\n", NR; bad = 1; next }
      n = split(tolower(t), w, /[ \t{},()]+/)
      for (i = 1; i <= n; i++) if (w[i] ~ /^(anchor|load|include|table|rdr|nat|binat|scrub|antispoof|set|route-to|reply-to|dup-to|divert-to|divert-reply|divert-packet|nat-to|rdr-to|af-to|rtable)$/) { printf "line %d: \"%s\" is not allowed in a drop-in\n", NR, w[i]; bad = 1; next }
      d = 0; for (i = 1; i <= length(t); i++) { ch = substr(t, i, 1); if (ch == "{") d++; else if (ch == "}") { d--; if (d < 0) break } }
      if (d != 0) { printf "line %d: braces must balance within the line\n", NR; bad = 1 }
    }
    END { exit bad }' "$1"
}

# pf_check_ruleset <dir-with-candidate-dropins>: parse the rendered anchor without loading it.
pf_check_ruleset() {
  local t; t=$(mktemp); pf_render_firewall "$1" "$t"
  local out; out=$(pfctl -n -a "$PF_FW_ANCHOR" -f "$t" 2>&1); local rc=$?
  rm -f "$t"; printf '%s' "$(grep -v 'ALTQ' <<<"$out" | sed "s#^$t#rules#" | head -n 5)"; return $rc
}
pf_load_firewall() { pf_ready; pf_render_firewall "$PF_DROPIN_DIR" "$PF_FW_FILE" && chmod 0644 "$PF_FW_FILE" && pfctl_run -a "$PF_FW_ANCHOR" -f "$PF_FW_FILE"; }
pf_fw_loaded() { [[ -n "$(pfctl -a "$PF_FW_ANCHOR" -s rules 2>/dev/null)" ]]; }
pf_reload_if_active() { if pf_enabled && pf_fw_loaded; then pf_load_firewall && echo true || echo false; else echo false; fi; }

# The marked pf.conf block (FreeBSD): the anchor reference, and the firewall anchor loaded at boot.
pf_conf_write() { # <add|remove>
  local tmp; tmp=$(mktemp)
  if [[ -f "$PF_CONF" ]]; then awk -v b="$PF_MARK_BEGIN" -v e="$PF_MARK_END" '$0 == b {skip = 1} !skip {print} $0 == e {skip = 0}' "$PF_CONF" > "$tmp"
  else printf '# /etc/pf.conf created by fips-ui: everything passes except what the fips-ui anchors decide.\npass all\n' > "$tmp"; fi
  if [[ "$1" == add ]]; then
    # The guard's reference goes before the first filter rule, so no earlier "quick" rule can pass spoofed traffic;
    # the firewall's goes last, so its default deny is the last match for the FIPS interface.
    local t2; t2=$(mktemp)
    awk -v b="$PF_MARK_BEGIN" -v e="$PF_MARK_END" -v g="$PF_GUARD_ANCHOR" '
      !done && /^[[:space:]]*(pass|block|match|anchor|antispoof)([[:space:]]|$)/ { print b; printf "anchor \"%s\"\n", g; print e; done = 1 }
      { print }
      END { if (!done) { print b; printf "anchor \"%s\"\n", g; print e } }' "$tmp" > "$t2"
    printf '%s\nanchor "%s"\nload anchor "%s" from "%s"\n%s\n' "$PF_MARK_BEGIN" "$PF_FW_ANCHOR" "$PF_FW_ANCHOR" "$PF_FW_FILE" "$PF_MARK_END" >> "$t2"
    mv -f "$t2" "$tmp"
  fi
  local err; if ! err=$(pfctl_run -n -f "$tmp" 2>&1); then rm -f "$tmp"; die "the new pf.conf does not parse: $(head -n 3 <<<"$err" | tr '\n' ' ')"; fi
  local m=644 u=0 g=0; [[ -f "$PF_CONF" ]] && read -r m u g < <(file_perms "$PF_CONF")
  [[ -f "$PF_CONF" ]] && cp -p "$PF_CONF" "$PF_CONF.fips-ui.bak"
  install -m "$m" -o "$u" -g "$g" "$tmp" "$PF_CONF.fips-ui.new" && mv -f "$PF_CONF.fips-ui.new" "$PF_CONF"; rm -f "$tmp"
}

# pf firewall actions for the fips-firewall "unit" (Firewall page buttons).
pf_fw_action() { # <start|stop|restart|reload|enable|disable>
  pf_ready
  case "$1" in
    start|restart|reload)
      pf_referenced || die "pf does not evaluate the fips-ui anchors yet: use Enable, which adds them to $PF_CONF and turns pf on at boot"
      if ! pf_enabled; then if [[ "$OS" == Darwin ]]; then pfctl -E >/dev/null 2>&1; else pfctl -e >/dev/null 2>&1; fi; fi
      pf_load_firewall ;;
    stop) pfctl -a "$PF_FW_ANCHOR" -F rules >/dev/null 2>&1 ;;
    enable)
      [[ "$OS" == FreeBSD ]] || die "enabling at boot is not supported on macOS: pf is started by the system's own configuration; use Start"
      pf_render_firewall "$PF_DROPIN_DIR" "$PF_FW_FILE" && chmod 0644 "$PF_FW_FILE"
      pf_conf_write add   # rewrites the marked blocks, so an older layout is brought up to date
      sysrc -q pf_enable=YES >/dev/null
      if pf_enabled; then pfctl_run -f "$PF_CONF"; else rc_script service pf start; fi ;;
    disable)
      [[ "$OS" == FreeBSD ]] || die "not supported on macOS"
      if pf_conf_has_block; then pf_conf_write remove; if pf_enabled; then pfctl_run -f "$PF_CONF"; fi; fi
      pfctl -a "$PF_FW_ANCHOR" -F rules >/dev/null 2>&1 ;;
  esac
  return 0
}

# Drop packets/bytes of the baseline's block rule and the number of rules in the firewall anchor, as JSON.
pf_fw_summary() {
  pfctl -a "$PF_FW_ANCHOR" -v -s rules 2>/dev/null | awk '
    /^[a-z]/ { rules++; blk = ($0 ~ /label "fips-ui drop"/) }
    blk && /Packets:/ { for (i = 1; i <= NF; i++) { if ($i == "Packets:") p = $(i+1); if ($i == "Bytes:") b = $(i+1) } blk = 0 }
    END { printf "{\"dropPackets\":%d,\"dropBytes\":%d,\"rules\":%d}", p, b, rules }'
}

# ---------------------------------------------------------------- fresh daemon install (v9)
# Installs fips on a machine without it, from an official release only: the helper downloads the release itself
# and checks it against the release's checksums file, so the caller chooses at most the version, never the file.
# FIPS_UI_FIPS_REPO, FIPS_UI_FIPS_ARTIFACT and FIPS_UI_PFSENSE_PRODUCT only apply when root runs the helper
# directly (deploy/install-fips.sh): sudo's env_reset drops them for the UI.
FIPS_RELEASE_REPO=${FIPS_UI_FIPS_REPO:-jmcorgan/fips}

# Any trace of an installed daemon: a binary (also one built from source), its socket, service or group.
# Installing a second one beside it would fight over the control socket.
fips_trace() {
  local b
  for b in fips /usr/bin/fips /usr/local/bin/fips /usr/local/sbin/fips "$BIN_DIR/fips"; do command -v "$b" >/dev/null 2>&1 && { echo "binary $(command -v "$b")"; return 0; }; done
  for b in /run/fips/control.sock /var/run/fips/control.sock; do [[ -S "$b" ]] && { echo "control socket $b"; return 0; }; done
  for b in /etc/systemd/system/fips.service /lib/systemd/system/fips.service /usr/lib/systemd/system/fips.service /usr/local/etc/rc.d/fips /usr/local/etc/rc.d/fips.sh /Library/LaunchDaemons/com.fips.daemon.plist; do
    [[ -e "$b" ]] && { echo "service $b"; return 0; }
  done
  group_exists fips && { echo "group fips"; return 0; }
  return 1
}
group_exists() {
  if command -v getent >/dev/null 2>&1; then getent group "$1" >/dev/null
  elif [[ "$OS" == Darwin ]]; then dscl . -read "/Groups/$1" >/dev/null 2>&1
  else pw groupshow "$1" >/dev/null 2>&1; fi
}
add_to_group() { # <user> <group>
  id -nG "$1" 2>/dev/null | tr ' ' '\n' | grep -qx "$2" && return 0
  case "$OS" in
    Linux)   usermod -aG "$2" "$1" ;;
    FreeBSD) pw groupmod "$2" -m "$1" ;;
    Darwin)  dseditgroup -o edit -a "$1" -t user "$2" ;;
  esac && log "added $1 to the $2 group"
}
download() { # <url> <file>
  if command -v curl >/dev/null 2>&1; then curl -fsSL --retry 3 -o "$2" "$1" 9>&-
  elif command -v fetch >/dev/null 2>&1; then fetch -q -o "$2" "$1" 9>&-
  else die "neither curl nor fetch is installed"; fi
}
sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
  elif command -v sha256 >/dev/null 2>&1; then sha256 -q "$1"
  else shasum -a 256 "$1" | cut -d' ' -f1; fi
}
wait_socket() { local s; for _ in $(seq 1 60); do for s in /run/fips/control.sock /var/run/fips/control.sock; do [[ -S "$s" ]] && { echo "$s"; return 0; }; done; sleep 0.5; done; return 1; }

# The release's fips.yaml starts an isolated node: a new identity at every start and no peers. Before the first
# start, keep the identity (fips-ui's mesh access and hosts names are per npub) and add the bootstrap peers.
# A peer is "<npub>@<udp|tcp>/<host:port>".
PEER_RE='^(npub1[02-9ac-hj-np-z]{58})@(udp|tcp)/([A-Za-z0-9.-]{1,253}|\[[0-9A-Fa-f:.]{2,45}\]|[0-9.]{7,15}):([0-9]{1,5})$'
initial_config() { # <peer>...
  local cfg=$FIPS_CONFIG tmp p block=""
  [[ -f "$cfg" ]] || { log "warning: $cfg not found; the identity and peers are not set"; return 0; }
  for p in "$@"; do
    [[ "$p" =~ $PEER_RE ]] || die "invalid peer $p"
    block+=$(printf '\n  - npub: "%s"\n    addresses:\n      - transport: %s\n        addr: "%s:%s"\n    connect_policy: auto_connect' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}")
  done
  tmp=$(mktemp "$cfg.XXXXXX")
  # persistent: the template's commented "# persistent: true" under node.identity, or a new line after "identity:".
  # peers: the template's "peers: []" becomes the list; a config without that line keeps its peers.
  # The peers go through the environment: awk -v rejects values with newlines (BSD awk).
  PEERS="$block" awk '
    BEGIN { peers = ENVIRON["PEERS"] }
    /^  identity:[[:space:]]*$/ { print; idn = 1; next }
    idn && /^    # persistent: true[[:space:]]*$/ { print "    persistent: true"; done_p = 1; idn = 0; next }
    idn && /^    persistent:/ { print "    persistent: true"; done_p = 1; idn = 0; next }
    idn && !/^    / && !/^[[:space:]]*$/ { if (!done_p) print "    persistent: true"; done_p = 1; idn = 0 }
    /^peers: \[\][[:space:]]*$/ && peers != "" { printf "peers:%s\n", peers; done_peers = 1; next }
    { print }
    END { if (!done_p) print "warning: no node.identity section; persistent identity not set" > "/dev/stderr"
          if (peers != "" && !done_peers) print "warning: no \"peers: []\" line; peers not added" > "/dev/stderr" }
  ' "$cfg" > "$tmp"
  local mode uid gid; read -r mode uid gid <<<"$(file_perms "$cfg")"
  chmod "$mode" "$tmp"; chown "$uid:$gid" "$tmp"
  mv -f "$tmp" "$cfg"
  log "$cfg: persistent identity${block:+, $# peer(s)}"
}

daemon_install() { # [tag] [peer...]
  local tag=${1:-} work tag_found file sums want got arch deb_arch bsd_arch abi product sock found
  [[ -z "$tag" || "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ ]] || die "invalid tag (use vX.Y.Z)"
  shift || true
  local peer; for peer in "$@"; do [[ "$peer" =~ $PEER_RE ]] || die "invalid peer $peer (use npub1...@udp/host:port)"; done
  (( $# <= 16 )) || die "at most 16 peers"
  [[ "$FIPS_RELEASE_REPO" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "invalid FIPS_UI_FIPS_REPO"
  if found=$(fips_trace); then die "fips is already installed ($found); upgrade it instead"; fi
  case "$SM" in systemd|rc|pfsense|launchd) ;; *) die "fresh installs are supported with systemd, FreeBSD rc.d, pfSense and launchd (this system: $SM)" ;; esac
  case "$(uname -m)" in x86_64|amd64) arch=x86_64 deb_arch=amd64 bsd_arch=amd64 ;; aarch64|arm64) arch=aarch64 deb_arch=arm64 bsd_arch=aarch64 ;; *) die "no fips release for $(uname -m)" ;; esac
  DI_WORK=$(mktemp -d); trap 'rm -rf "$DI_WORK"' EXIT; work=$DI_WORK
  local base="https://github.com/$FIPS_RELEASE_REPO/releases"
  # The newest release: github.com redirects releases/latest to releases/tag/<tag> (no API call, so no API rate
  # limit). fips-ui passes the tag it already knows.
  if [[ -z "$tag" ]]; then
    if command -v curl >/dev/null 2>&1; then
      tag=$(curl -fsSLI -o /dev/null -w '%{url_effective}' "$base/latest" 9>&- | sed -n 's|.*/releases/tag/\(v[^/]*\)$|\1|p')
    else
      download "https://api.github.com/repos/$FIPS_RELEASE_REPO/releases/latest" "$work/release.json" || die "cannot read the newest release"
      tag=$(sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' "$work/release.json" | head -n 1)
    fi
  fi
  [[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ ]] || die "cannot find the newest release of $FIPS_RELEASE_REPO"
  tag_found=$tag
  local ver=${tag#v} candidates=() c
  # Asset names follow upstream's packaging (as server/upgrade.ts expects them).
  case "$SM" in
    systemd)
      sums=checksums-linux.txt
      # The .deb only where apt manages packages (dpkg alone also exists on Arch or Fedora); FIPS_UI_FIPS_ARTIFACT=tarball skips it.
      if command -v apt-get >/dev/null 2>&1 && [[ -f /etc/debian_version && "${FIPS_UI_FIPS_ARTIFACT:-}" != tarball ]]; then candidates+=("fips_${ver}_${deb_arch}.deb"); fi
      candidates+=("fips-${ver}-linux-${arch}.tar.gz") ;;
    rc) sums=checksums-freebsd.txt; candidates=("fips-${ver}-freebsd-${bsd_arch}.pkg") ;;
    pfsense)
      sums=checksums-freebsd.txt
      abi=$(pkg config abi 2>/dev/null || true)
      # Upstream names pfSense packages after the products an ABI serves (like server/upgrade.ts).
      case "$abi" in FreeBSD:15:amd64) product=ce2.8 ;; FreeBSD:16:amd64) product=ce2.9-plus26 ;; FreeBSD:16:aarch64) product=plus26 ;; *) product="" ;; esac
      product=${FIPS_UI_PFSENSE_PRODUCT:-$product}
      [[ "$product" =~ ^[A-Za-z0-9.-]+$ ]] || die "no pfSense package is known for ABI '$abi'; install with FIPS_UI_PFSENSE_PRODUCT set (e.g. ce2.9-plus26)"
      candidates=("fips-${ver}-pfsense-${product}-${bsd_arch}.pkg") ;;
    launchd) sums=checksums-macos.txt; candidates=("fips-${ver}-macos-$([[ $arch == x86_64 ]] && echo x86_64 || echo arm64).pkg") ;;
  esac
  download "$base/download/$tag/$sums" "$work/$sums" || die "release $tag publishes no $sums (or it cannot be downloaded)"
  file=""
  for c in "${candidates[@]}"; do grep -qE "[[:space:]]\*?$(sed 's/[.]/\\./g' <<<"$c")\$" "$work/$sums" && { file=$c; break; }; done
  [[ -n "$file" ]] || die "release $tag publishes no fips package for this system (${candidates[*]})"
  log "fips $tag_found: $file"
  download "$base/download/$tag/$file" "$work/$file" || die "download of $file failed"
  want=$(awk -v f="$file" '$2 == f || $2 == "*" f {print $1}' "$work/$sums" | head -n 1)
  [[ -n "$want" ]] || die "$sums has no checksum for $file"
  got=$(sha256_file "$work/$file")
  [[ "$got" == "$want" ]] || die "checksum mismatch for $file (expected $want, got $got)"
  log "sha256 ok"
  # Install without starting where the package allows it, write the initial configuration, then (re)start.
  case "$SM" in
    systemd)
      if [[ "$file" == *.deb ]]; then DEBIAN_FRONTEND=noninteractive apt-get install -y -q "$work/$file" >&2 9>&-
      else
        tar xzf "$work/$file" -C "$work"
        [[ -x "$work/${file%.tar.gz}/install.sh" ]] || die "the tarball has no install.sh"
        "$work/${file%.tar.gz}/install.sh" >&2 9>&-
      fi ;;
    rc|pfsense) pkg add "$work/$file" >&2 9>&- ;;
    launchd) installer -pkg "$work/$file" -target / >&2 9>&- ;;
  esac
  initial_config "$@"
  case "$SM" in
    systemd) systemctl enable fips.service >&2 9>&-; systemctl restart fips.service >&2 9>&- ;;
    rc) sysrc -q fips_enable=YES >/dev/null; rc_script service fips restart >&2 || rc_script service fips start >&2 || true ;;
    pfsense) [[ -x /usr/local/etc/rc.d/fips.sh ]] && { rc_script /usr/local/etc/rc.d/fips.sh restart >&2 || true; } ;;
    launchd) launchctl kickstart -k "system/$SERVICE" >&2 9>&- || true ;;
  esac
  sock=$(wait_socket) || die "fips $tag_found was installed but its control socket did not appear; check the daemon's log"
  # The UI's user reaches the socket through the fips group (it did not exist when fips-ui was set up).
  if [[ -n "${SUDO_USER:-}" && "$SUDO_USER" != root ]] && group_exists fips; then add_to_group "$SUDO_USER" fips || log "warning: could not add $SUDO_USER to the fips group"; fi
  log "fips $tag_found is installed and running (control socket $sock)"
  printf '{"ok":true,"tag":%s,"artifact":%s,"socket":%s}\n' "$(json_escape "$tag_found")" "$(json_escape "$file")" "$(json_escape "$sock")"
}

# ---------------------------------------------------------------- commands
cmd=${1:-}
case "$cmd" in
  check)
    ensure_backups_dir
    # What this system supports: configuration, hosts file and services with any managed service manager;
    # the firewall and the mesh-access guard with nftables (Linux).
    managed=false; ( require_managed ) >/dev/null 2>&1 && managed=true
    fw=$(fw_backend); guard=$(guard_backend)
    if [[ "$fw" == pf ]]; then fw_dir=$PF_DROPIN_DIR; fw_ext=.pf; else fw_dir=$DROPIN_DIR; fw_ext=.nft; fi
    printf '{"ok":true,"version":%s,"managed_by":%s,"os":%s,"service_manager":%s,"service":%s,"bin_dir":%s,"backups_dir":%s,"current":%s,"config_path":%s,"hosts_path":%s,"firewall_dropin_dir":%s,"firewall_dropin_ext":%s,"features":{"config":%s,"hosts":%s,"services":%s,"firewall":%s,"guard":%s}}\n' \
      "$HELPER_VERSION" "$($NIXOS && echo '"nix"' || echo null)" "$(json_escape "$OS")" "$(json_escape "$SM")" "$(json_escape "$SERVICE")" \
      "$(json_escape "$BIN_DIR")" "$(json_escape "$BACKUPS_DIR")" "$(json_escape "$(current_version)")" \
      "$(json_escape "$FIPS_CONFIG")" "$(json_escape "$FIPS_HOSTS")" "$(json_escape "$fw_dir")" "$(json_escape "$fw_ext")" "$managed" "$managed" "$managed" "$(json_escape "$fw")" "$(json_escape "$guard")"
    ;;

  install)
    nix_managed
    take_lock
    stage=${2:-}
    [[ -n "$stage" ]] || die "usage: install <stagedir> [--no-restart]"
    [[ "$stage" == /* ]] || die "stage dir must be an absolute path"
    [[ -d "$stage" ]] || die "stage dir $stage does not exist"
    no_restart=false; [[ "${3:-}" == "--no-restart" ]] && no_restart=true
    log "current: $(current_version)"
    backup_id=$(do_backup)
    if [[ -f "$stage/PACKAGE" ]]; then
      pkgfile="$stage/$(head -n 1 "$stage/PACKAGE")"
      [[ -f "$pkgfile" ]] || die "package file $pkgfile missing"
      install_package "$pkgfile"
      newver=$(current_version)
    else
      [[ -f "$stage/fips" ]] || die "$stage/fips missing"
      runs "$stage/fips" || die "staged fips does not run"
      newver=$("$stage/fips" --version 2>&1 | head -n 1)
      log "new:     $newver"
      install_binaries "$stage"
    fi
    restarted=false
    if ! $no_restart; then restarted=$(restart_services); fi
    printf '{"ok":true,"backup_id":%s,"installed_version":%s,"restarted":%s}\n' \
      "$(json_escape "$backup_id")" "$(json_escape "$newver")" "$restarted"
    ;;

  rollback)
    nix_managed
    take_lock
    id=${2:-}
    [[ "$id" =~ ^[A-Za-z0-9._-]{1,80}$ ]] || die "invalid backup id"
    dir="$BACKUPS_DIR/$id"
    [[ -d "$dir" && -f "$dir/fips" ]] || die "backup $id not found"
    log "rolling back to $id ($(cat "$dir/VERSION" 2>/dev/null || echo '?'))"
    pre=$(do_backup)
    install_binaries "$dir"
    restarted=$(restart_services)
    printf '{"ok":true,"restored":%s,"pre_rollback_backup":%s,"restarted":%s}\n' \
      "$(json_escape "$id")" "$(json_escape "$pre")" "$restarted"
    ;;

  restart)
    take_lock
    restarted=$(restart_services)
    printf '{"ok":true,"restarted":%s}\n' "$restarted"
    ;;

  config-show)
    f="$FIPS_CONFIG"
    if [[ -n "${2:-}" ]]; then valid_id "$2"; f="$CONFIG_BACKUPS_DIR/$2.yaml"; fi
    [[ -f "$f" ]] || die "$f not found"
    outf=$(mktemp); errf=$(mktemp); trap 'rm -f "$outf" "$errf"' EXIT
    # The redactor reads the file once, hashes exactly those bytes and prints "base <sha256>" first, so the
    # text shown and the hash config-apply --base must match can never come from different versions.
    if ! redact "$f" >"$outf" 2>"$errf"; then
      die "cannot show this file safely: $(head -n 8 "$errf" | tr '\n' ';') edit it from a shell"
    fi
    cat "$outf"
    ;;

  config-apply)
    require_managed; take_lock
    restart=true; base=""; shift
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --no-restart) restart=false ;;
        --base) [[ "${2:-}" =~ ^[0-9a-f]{64}$ ]] || die "--base needs the sha256 printed by config-show"; base=$2; shift ;;
        *) die "unknown option $1" ;;
      esac
      shift
    done
    [[ -n "$base" ]] || die "--base is required (the sha256 printed by config-show)"
    [[ -f "$FIPS_CONFIG" ]] || die "$FIPS_CONFIG not found"
    tmp=$(mktemp); tmp2=$(mktemp); trap 'rm -f "$tmp" "$tmp2"' EXIT
    read_stdin_limited "$tmp" "$MAX_CONFIG_BYTES"
    # The restorer checks --base against the exact bytes it reads, so nothing can change in between.
    if ! err=$(restore_secrets "$FIPS_CONFIG" "$tmp" "$tmp2" "$base" 2>&1); then die "$(printf '%s' "$err" | head -n 3 | tr '\n' ' ')"; fi
    grep -q '<redacted #' "$tmp2" && die "a redaction placeholder is still present"
    if cmp -s "$tmp2" "$FIPS_CONFIG"; then printf '{"ok":true,"changed":false,"restarted":false}\n'; exit 0; fi
    id=$(backup_config)
    install_config_and_restart "$tmp2" "$id" "$restart"
    ;;

  config-backups)
    mkdir -p "$CONFIG_BACKUPS_DIR"; chmod 0700 "$CONFIG_BACKUPS_DIR"
    printf '['; first=true
    for f in $(ls -1t "$CONFIG_BACKUPS_DIR"/*.yaml 2>/dev/null); do
      $first || printf ','; first=false
      printf '{"id":%s,"size":%s,"mtime":%s}' "$(json_escape "$(basename "$f" .yaml)")" "$(wc -c < "$f" | tr -d ' ')" "$(stat -c %Y "$f" 2>/dev/null || stat -f %m "$f")"
    done
    printf ']\n'
    ;;

  config-restore)
    require_managed; take_lock
    valid_id "${2:-}"; f="$CONFIG_BACKUPS_DIR/$2.yaml"; [[ -f "$f" ]] || die "config backup $2 not found"
    tmp=$(mktemp); trap 'rm -f "$tmp"' EXIT; cp -p "$f" "$tmp"
    id=$(backup_config "$2")
    install_config_and_restart "$tmp" "$id" true
    ;;

  firewall-status)
    if [[ "$(fw_backend)" == pf ]]; then
      pf_ready
      en=false; pf_enabled && en=true; ref=false; pf_referenced && ref=true; loaded=false; pf_fw_loaded && loaded=true
      tun_now=$(pf_tun || true); tun_anchor=$(pf_anchor_tun)
      # Rules for an interface fips no longer uses protect nothing.
      stale=false; [[ $loaded == true && -n "$tun_now" && "$tun_anchor" != "$tun_now" ]] && stale=true
      active=false; $en && $loaded && $ref && ! $stale && active=true
      if [[ "$OS" == FreeBSD ]]; then boot=disabled; pf_conf_has_block && [[ "$(sysrc -n pf_enable 2>/dev/null)" =~ ^[Yy][Ee][Ss]$ ]] && boot=enabled; else boot=unsupported; fi
      printf '{"ok":true,"backend":"pf","unit_active":%s,"unit_enabled":%s,"table_loaded":%s,"ruleset":null,"summary":%s,"pf_enabled":%s,"anchor_referenced":%s,"anchor":%s,"tun":%s,"anchor_tun":%s,"stale_interface":%s}\n' \
        "$active" "$(json_escape "$boot")" "$loaded" "$(pf_fw_summary)" "$en" "$ref" "$(json_escape "$PF_FW_ANCHOR")" "$(json_escape "$tun_now")" "$(json_escape "$tun_anchor")" "$stale"
      exit 0
    fi
    require_systemd
    active=false; systemctl is-active --quiet fips-firewall.service && active=true
    enabled=$(systemctl is-enabled fips-firewall.service 2>/dev/null || true)
    ruleset=null; loaded=false
    if command -v nft >/dev/null 2>&1 && out=$(nft -j list table inet fips 2>/dev/null) && [[ -n "$out" ]]; then ruleset=$out; loaded=true; fi
    printf '{"ok":true,"unit_active":%s,"unit_enabled":%s,"table_loaded":%s,"ruleset":%s}\n' "$active" "$(json_escape "${enabled:-unknown}")" "$loaded" "$ruleset"
    ;;

  dropin-apply)
    if [[ "$(fw_backend)" == pf ]]; then
      take_lock; name=${2:-}; valid_dropin "$name"
      tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
      read_stdin_limited "$tmp/new" "$MAX_DROPIN_BYTES"
      if ! err=$(pf_check_dropin_content "$tmp/new"); then printf '{"ok":false,"error":"the drop-in contains statements that are not allowed","detail":%s}\n' "$(json_escape "$err")"; exit 0; fi
      pf_ready
      mkdir "$tmp/d"; cp -p "$PF_DROPIN_DIR"/*.pf "$tmp/d/" 2>/dev/null || true; cp "$tmp/new" "$tmp/d/$name.pf"
      if ! err=$(pf_check_ruleset "$tmp/d"); then printf '{"ok":false,"error":"pfctl rejected the rules","detail":%s}\n' "$(json_escape "$err")"; exit 0; fi
      mkdir -p "$PF_DROPIN_DIR"
      install -m 0644 -o 0 -g 0 "$tmp/new" "$PF_DROPIN_DIR/$name.pf"
      printf '{"ok":true,"file":%s,"reloaded":%s}\n' "$(json_escape "$PF_DROPIN_DIR/$name.pf")" "$(pf_reload_if_active)"
      exit 0
    fi
    require_systemd; take_lock
    name=${2:-}; valid_dropin "$name"
    command -v nft >/dev/null 2>&1 || die "nft not found"
    [[ -f "$FIPS_NFT" ]] || die "$FIPS_NFT not found"
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    read_stdin_limited "$tmp/new" "$MAX_DROPIN_BYTES"
    if ! err=$(check_dropin_content "$tmp/new"); then printf '{"ok":false,"error":"the drop-in contains statements that are not allowed","detail":%s}\n' "$(json_escape "$err")"; exit 0; fi
    mkdir "$tmp/d"; cp -a "$DROPIN_DIR/." "$tmp/d/" 2>/dev/null || true; cp "$tmp/new" "$tmp/d/$name.nft"
    if ! err=$(check_ruleset "$tmp/d"); then printf '{"ok":false,"error":"nft rejected the ruleset","detail":%s}\n' "$(json_escape "$err")"; exit 0; fi
    mkdir -p "$DROPIN_DIR"
    install -m 0644 -o 0 -g 0 "$tmp/new" "$DROPIN_DIR/$name.nft"
    printf '{"ok":true,"file":%s,"reloaded":%s}\n' "$(json_escape "$DROPIN_DIR/$name.nft")" "$(firewall_reload_if_active)"
    ;;

  hosts-apply)
    require_managed; take_lock
    [[ "${2:-}" == --base && "${3:-}" =~ ^([0-9a-f]{64}|none)$ ]] || die "usage: hosts-apply --base <sha256|none>"
    base=$3
    tmp=$(mktemp); trap 'rm -f "$tmp"' EXIT
    read_stdin_limited "$tmp" "$MAX_HOSTS_BYTES"
    # Every line is blank, a comment, or "hostname npub [# comment]" (docs/how-to/host-aliases.md upstream);
    # lines already in the current file are accepted as they are, so one hand-written line cannot block edits.
    cur_lines=$(mktemp); trap 'rm -f "$tmp" "$cur_lines"' EXIT
    { [[ -f "$FIPS_HOSTS" ]] && tr -d '\r' < "$FIPS_HOSTS"; } > "$cur_lines" || true
    bad=$(tr -d '\r' < "$tmp" | grep -nvxFf "$cur_lines" | grep -vE '^[0-9]+:[[:space:]]*(#.*)?$|^[0-9]+:[[:space:]]*[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?[[:space:]]+npub1[02-9ac-hj-np-z]{58}[[:space:]]*(#.*)?$' | head -n 3 || true)
    [[ -z "$bad" ]] || die "invalid hosts line(s): $(printf '%s' "$bad" | tr '\n' ' ')"
    cur=none; [[ -f "$FIPS_HOSTS" ]] && cur=$(sha256_stdin < "$FIPS_HOSTS")
    [[ "$cur" == "$base" ]] || die "$FIPS_HOSTS changed since it was read; reload and make the change again"
    if [[ -f "$FIPS_HOSTS" ]] && cmp -s "$tmp" "$FIPS_HOSTS"; then printf '{"ok":true,"changed":false}\n'; exit 0; fi
    if [[ -f "$FIPS_HOSTS" ]]; then
      mkdir -p "$CONFIG_BACKUPS_DIR"; chmod 0700 "$CONFIG_BACKUPS_DIR"
      cp -p "$FIPS_HOSTS" "$CONFIG_BACKUPS_DIR/hosts-$(date +%Y%m%d-%H%M%S)"
      # Keep the newest 20 hosts backups.
      keep_newest 20 "$CONFIG_BACKUPS_DIR"/hosts-*
    fi
    mkdir -p "$(dirname "$FIPS_HOSTS")"
    # root:root 0644; on NixOS as upstream's module seeds it (root:fips 0664, the fips group edits it too).
    hm=0644 hu=0 hg=0
    if $NIXOS && [[ -f "$FIPS_HOSTS" ]]; then read -r hm hu hg < <(file_perms "$FIPS_HOSTS"); fi
    install -m "$hm" -o "$hu" -g "$hg" "$tmp" "$FIPS_HOSTS.fips-ui.new" && mv -f "$FIPS_HOSTS.fips-ui.new" "$FIPS_HOSTS"
    printf '{"ok":true,"changed":true,"file":%s}\n' "$(json_escape "$FIPS_HOSTS")"
    ;;

  dropin-delete)
    if [[ "$(fw_backend)" == pf ]]; then
      take_lock; name=${2:-}; valid_dropin "$name"
      [[ -f "$PF_DROPIN_DIR/$name.pf" ]] || die "drop-in $name not found"
      rm -f -- "$PF_DROPIN_DIR/$name.pf"
      printf '{"ok":true,"reloaded":%s}\n' "$(pf_reload_if_active)"
      exit 0
    fi
    require_systemd; take_lock
    name=${2:-}; valid_dropin "$name"
    [[ -f "$DROPIN_DIR/$name.nft" ]] || die "drop-in $name not found"
    rm -f -- "$DROPIN_DIR/$name.nft"
    printf '{"ok":true,"reloaded":%s}\n' "$(firewall_reload_if_active)"
    ;;

  service)
    require_managed; take_lock
    trap '' INT TERM HUP
    action=${2:-}; unit=${3:-}
    case "$action" in start|stop|restart|reload|enable|disable) ;; *) die "action must be start, stop, restart, reload, enable or disable" ;; esac
    case "$unit" in fips|fips-firewall|fips-dns|fips-gateway) ;; *) die "unit must be fips, fips-firewall, fips-dns or fips-gateway" ;; esac
    # With pf the fips firewall is not a service but the fips-ui anchor: its buttons act on pf.
    if [[ "$unit" == fips-firewall && "$(fw_backend)" == pf ]]; then
      pf_fw_action "$action"
      en=false; pf_enabled && pf_fw_loaded && en=true
      if [[ "$OS" == FreeBSD ]]; then boot=disabled; pf_conf_has_block && [[ "$(sysrc -n pf_enable 2>/dev/null)" =~ ^[Yy][Ee][Ss]$ ]] && boot=enabled; else boot=unsupported; fi
      printf '{"ok":true,"unit":"pf anchor %s","active":%s,"enabled":%s}\n' "$PF_FW_ANCHOR" "$en" "$(json_escape "$boot")"
      exit 0
    fi
    # The unit's name under this service manager; a unit this system does not have is refused.
    native=$(svc_native "$unit")
    [[ -n "$native" ]] && svc_exists "$native" || die "$unit is not installed as a service here ($SM)"
    case "$action" in
      start)   svc_start "$native" ;;
      stop)    svc_stop "$native" ;;
      restart) svc_restart "$native" ;;
      reload)  if [[ "$SM" == systemd ]]; then systemctl reload-or-restart "$native"; else svc_restart "$native"; fi ;;
      enable|disable) svc_enable "$native" "$([[ "$action" == enable ]] && echo true || echo false)" || die "$action is not supported with $SM" ;;
    esac
    a=false; svc_active "$native" && a=true
    printf '{"ok":true,"unit":%s,"active":%s,"enabled":%s}\n' "$(json_escape "$native")" "$a" "$(json_escape "$(svc_enabled "$native")")"
    ;;

  mesh-guard)
    ports=${2:-}; tun=${3:-fips0}; canary=${4:-}
    [[ "$tun" =~ ^[A-Za-z0-9_.-]{1,15}$ ]] || die "invalid interface name"
    [[ -z "$canary" || ( "$canary" =~ ^[0-9]{1,5}$ && "$canary" -ge 1024 && "$canary" -le 65535 ) ]] || die "invalid canary port"
    if [[ "$(guard_backend)" == pf ]]; then
      pf_ready
      if [[ "$ports" == status ]]; then
        out=$(pfctl -a "$PF_GUARD_ANCHOR" -s rules 2>/dev/null || true; pfctl -a "$PF_GUARD_ANCHOR/spoof" -s rules 2>/dev/null || true)
        if pf_enabled && pf_guard_first && ! pf_lo_skipped && grep -q 'label "fips-ui guard"' <<<"$out"; then
          g=$(grep 'label "fips-ui guard"' <<<"$out")
          p=$(sed -E 's/.*port (= )?//; s/ label.*//' <<<"$g" | tr -c '0-9\n' ' ' | xargs | tr ' ' ',')
          tn=$(sed -nE 's/.* on ! ([A-Za-z0-9_.-]+) .*/\1/p' <<<"$g" | head -n 1)
          c=$(grep 'label "fips-ui canary"' <<<"$out" | sed -nE 's/.*port = ([0-9]+).*/\1/p' | head -n 1)
          printf '{"ok":true,"active":true,"ports":%s,"tun":%s,"canary":%s}\n' "$(json_escape "$p")" "$(json_escape "$tn")" "$(json_escape "$c")"
        else printf '{"ok":true,"active":false}\n'; fi
        exit 0
      fi
      take_lock
      if [[ "$ports" == off ]]; then
        pfctl -a "$PF_GUARD_ANCHOR/spoof" -F rules >/dev/null 2>&1; pfctl -a "$PF_GUARD_ANCHOR" -F rules >/dev/null 2>&1
        printf '{"ok":true,"active":false}\n'; exit 0
      fi
      [[ "$ports" =~ ^[0-9]{1,5}(,[0-9]{1,5}){0,3}$ ]] || die "ports must be a comma-separated list of up to 4 ports"
      for p in ${ports//,/ }; do (( p >= 1 && p <= 65535 )) || die "port $p out of range"; done
      # The guard never turns pf on by itself: that is the admin's decision (Firewall page).
      pf_enabled || { printf '{"ok":false,"error":"pf is not enabled on this system; turn on the fips firewall (Firewall page) so the spoofing guard can load"}\n'; exit 0; }
      pf_guard_first || { printf '{"ok":false,"error":"pf does not evaluate the guard before other rules: use Enable on the Firewall page (it puts the guard anchor before the first filter rule of /etc/pf.conf), and keep it first"}\n'; exit 0; }
      pf_lo_skipped && { printf '{"ok":false,"error":"pf.conf has \\"set skip on lo0\\", which also skips the guard'"'"'s self-check on loopback: remove it (or skip only other interfaces) for mesh access"}\n'; exit 0; }
      gf=$(mktemp); trap 'rm -f "$gf"' EXIT
      {
        [[ -n "$canary" ]] && echo "block return in quick on lo0 inet6 proto tcp from any to ::1 port $canary label \"fips-ui canary\""
        echo "anchor \"spoof\" in on ! lo0 {"
        echo "  block drop in quick on ! $tun inet6 proto tcp from fd00::/8 to any port { ${ports//,/, } } label \"fips-ui guard\""
        echo "}"
      } > "$gf"
      if ! err=$(pfctl_run -a "$PF_GUARD_ANCHOR" -f "$gf" 2>&1); then printf '{"ok":false,"error":%s}\n' "$(json_escape "$(head -n 3 <<<"$err")")"; exit 0; fi
      printf '{"ok":true,"active":true,"ports":%s,"tun":%s}\n' "$(json_escape "$ports")" "$(json_escape "$tun")"
      exit 0
    fi
    command -v nft >/dev/null 2>&1 || die "nft not found"
    if [[ "$ports" == status ]]; then
      if out=$(nft list table inet fips_ui_guard 2>/dev/null) && grep -q "iifname" <<<"$out"; then
        p=$(grep -E 'saddr fd00::/8' <<<"$out" | grep -oE 'dport \{? ?[0-9, ]+\}?' | grep -oE '[0-9]+' | paste -sd, -)
        t=$(grep -oE 'iifname \{ [^}]* \}' <<<"$out" | grep -oE '"[^"]+"' | tr -d '"' | grep -vx lo | head -n 1)
        c=$(grep -E 'canary' <<<"$out" | grep -oE 'dport [0-9]+' | grep -oE '[0-9]+' | head -n 1)
        printf '{"ok":true,"active":true,"ports":%s,"tun":%s,"canary":%s}\n' "$(json_escape "$p")" "$(json_escape "$t")" "$(json_escape "$c")"
      else printf '{"ok":true,"active":false}\n'; fi
      exit 0
    fi
    take_lock
    if [[ "$ports" == off ]]; then
      nft delete table inet fips_ui_guard 2>/dev/null || true
      printf '{"ok":true,"active":false}\n'; exit 0
    fi
    [[ "$ports" =~ ^[0-9]{1,5}(,[0-9]{1,5}){0,3}$ ]] || die "ports must be a comma-separated list of up to 4 ports"
    for p in ${ports//,/ }; do (( p >= 1 && p <= 65535 )) || die "port $p out of range"; done
    canary_rule=""
    [[ -n "$canary" ]] && canary_rule="iifname \"lo\" ip6 daddr ::1 tcp dport $canary reject with tcp reset comment \"fips-ui canary: proves this table is loaded\""
    # Priority -5 runs before the fips baseline; only fd00::/8 sources to these ports are affected.
    if ! err=$(nft -f - 2>&1 <<NFT
add table inet fips_ui_guard
flush table inet fips_ui_guard
table inet fips_ui_guard {
  chain input {
    type filter hook input priority -5; policy accept;
    ${canary_rule}
    iifname { "lo", "$tun" } return
    ip6 saddr fd00::/8 tcp dport { ${ports//,/, } } counter drop comment "fips-ui: mesh source addresses only via $tun"
  }
}
NFT
    ); then printf '{"ok":false,"error":%s}\n' "$(json_escape "$(printf '%s' "$err" | grep -E 'Error:' | head -n 3)")"; exit 0; fi
    printf '{"ok":true,"active":true,"ports":%s,"tun":%s}\n' "$(json_escape "$ports")" "$(json_escape "$tun")"
    ;;

  log-access)
    # Outside systemd the daemon logs to a file, which FreeBSD's package creates root-only: give the group that
    # owns the control socket (fips) read access. Nothing else about the file changes.
    require_managed; [[ "$SM" != systemd ]] || die "under systemd the log is the journal"
    take_lock
    logf=""
    for f in "$(sysrc -n fips_logfile 2>/dev/null || true)" /var/log/fips.log /var/log/fips/fips.log /usr/local/var/log/fips/fips.log; do
      [[ -n "$f" && -f "$f" ]] && { logf=$f; break; }
    done
    [[ -n "$logf" ]] || die "no fips log file found"
    [[ -f "$logf" && ! -L "$logf" ]] || die "$logf is not a regular file"
    [[ "$(stat -f %u "$logf" 2>/dev/null || stat -c %u "$logf")" == 0 ]] || die "$logf is not owned by root"
    grp=$(stat -f %Sg /var/run/fips 2>/dev/null || stat -c %G /var/run/fips 2>/dev/null || echo fips)
    [[ "$grp" =~ ^[A-Za-z0-9_-]+$ ]] || die "cannot tell the fips group"
    chgrp "$grp" "$logf" && chmod g+r,o-rwx "$logf"
    printf '{"ok":true,"file":%s,"group":%s}\n' "$(json_escape "$logf")" "$(json_escape "$grp")"
    ;;

  daemon-install)
    nix_managed
    take_lock
    shift
    daemon_install "$@"
    ;;

  daemon-installed)
    # Exit 0 and say what was found if fips is installed, 1 if not.
    if found=$(fips_trace); then echo "$found"; else exit 1; fi
    ;;

  list-backups)
    ensure_backups_dir
    printf '['
    first=true
    for d in $(ls -1dt "$BACKUPS_DIR"/*/ 2>/dev/null); do
      id=$(basename "$d")
      $first || printf ','
      first=false
      printf '{"id":%s,"version":%s}' "$(json_escape "$id")" "$(json_escape "$(cat "$d/VERSION" 2>/dev/null || echo '')")"
    done
    printf ']\n'
    ;;

  *)
    die "usage: $0 {check|install <stagedir> [--no-restart]|rollback <id>|restart|list-backups|config-show [id]|config-apply [--no-restart]|config-backups|config-restore <id>|firewall-status|dropin-apply <name>|dropin-delete <name>|service <action> <unit>|mesh-guard <ports|off|status> [tun] [canary]}"
    ;;
esac
