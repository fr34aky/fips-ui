#!/usr/bin/env bash
# fips-ui-helper — the only privileged part of the FIPS UI upgrade flow.
# Linux (systemd / OpenRC), macOS (launchd) and FreeBSD (rc.d).
#
# Installed root-owned at /usr/local/libexec/fips-ui-helper and reachable by
# the UI user through a single NOPASSWD sudoers rule (deploy/sudoers.d/fips-ui).
# The web backend stages binaries (or a release .pkg) as an unprivileged user;
# this script does the root-only steps: back up, swap the binaries (or run the
# native package installer), restart the service.
#
# Commands:
#   check                          -> {"ok":true,"version":2,...}
#   install <stagedir> [--no-restart]
#   rollback <backup-id>
#   restart
#   list-backups
#   config-show [backup-id]        -> fips.yaml (or a config backup) with secret values redacted as
#                                     numbered placeholders bound to their key and parent line
#   config-apply [--no-restart]    <- new fips.yaml on stdin; redacted placeholders are restored from
#                                     the current file; backed up, installed, daemon restarted and
#                                     rolled back automatically if it does not come up healthy
#   config-backups                 -> JSON list of config backups
#   config-restore <backup-id>     -> reinstall a config backup, restart with the same health check
#   firewall-status                -> JSON: unit state, whether table inet fips is loaded, live ruleset
#   dropin-apply <name>            <- nftables drop-in on stdin; validated with `nft -c` against the
#                                     full baseline before /etc/fips/fips.d/<name>.nft is written
#   dropin-delete <name>
#   service <action> <unit>        -> start|stop|restart|reload|enable|disable for fips units (systemd)
#
# Environment overrides (also honoured under sudo only if the sudoers rule
# passes them; the defaults are chosen per OS):
#   FIPS_BIN_DIR, FIPS_UI_BACKUPS, FIPS_SERVICE, FIPS_GATEWAY_SERVICE
#
# Anyone allowed to run "install" can place arbitrary root binaries — that is
# inherent to what an upgrade is. Restrict the sudoers rule to the UI user.

set -euo pipefail
umask 022

HELPER_VERSION=3
OS=$(uname -s)
BINARIES=(fips fipsctl fipstop fips-gateway)

case "$OS" in
  Darwin)
    BIN_DIR_DEFAULT=/usr/local/bin
    BACKUPS_DEFAULT=/usr/local/var/fips-ui/backups
    SERVICE_DEFAULT=com.fips.daemon
    GATEWAY_DEFAULT=com.fips.gateway
    ;;
  FreeBSD)
    BIN_DIR_DEFAULT=/usr/local/bin
    BACKUPS_DEFAULT=/var/db/fips-ui/backups
    SERVICE_DEFAULT=fips
    GATEWAY_DEFAULT=fips_gateway
    ;;
  *)
    BIN_DIR_DEFAULT=/usr/bin
    [[ -x /usr/bin/fips || ! -x /usr/local/bin/fips ]] || BIN_DIR_DEFAULT=/usr/local/bin
    BACKUPS_DEFAULT=/var/lib/fips-ui/backups
    SERVICE_DEFAULT=fips
    GATEWAY_DEFAULT=fips-gateway
    ;;
esac

BIN_DIR=${FIPS_BIN_DIR:-$BIN_DIR_DEFAULT}
BACKUPS_DIR=${FIPS_UI_BACKUPS:-$BACKUPS_DEFAULT}
SERVICE=${FIPS_SERVICE:-$SERVICE_DEFAULT}
GATEWAY_SERVICE=${FIPS_GATEWAY_SERVICE:-$GATEWAY_DEFAULT}

log() { printf '%s\n' "$*" >&2; }
die() { log "error: $*"; exit 1; }
# Minimal JSON string escaper (no python dependency).
json_escape() {
  local s=$1
  s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; s=${s//$'\t'/\\t}; s=${s//$'\r'/}
  printf '"%s"' "$s"
}

# Root is required for real installs. FIPS_UI_HELPER_TEST=1 allows exercising
# the file logic as a normal user against a private FIPS_BIN_DIR with
# FIPS_SERVICE=none (used by the test suite; never set this in sudoers).
if [[ $(id -u) -ne 0 ]]; then
  [[ ${FIPS_UI_HELPER_TEST:-0} == 1 && -n ${FIPS_BIN_DIR:-} && ${FIPS_SERVICE:-} == none ]] || die "must run as root (via sudo)"
fi

# ---------------------------------------------------------------- service mgr
detect_service_manager() {
  if [[ "$OS" == Darwin ]]; then echo launchd
  elif [[ "$OS" == FreeBSD ]]; then echo rc
  elif command -v systemctl >/dev/null 2>&1 && [[ -d /run/systemd/system ]]; then echo systemd
  elif command -v rc-service >/dev/null 2>&1; then echo openrc
  elif [[ -x /etc/init.d/fips ]]; then echo sysv
  else echo none; fi
}
SM=$(detect_service_manager)
[[ "$SERVICE" == none ]] && SM=none

svc_exists() {
  case "$SM" in
    systemd) systemctl cat "$1" >/dev/null 2>&1 ;;
    launchd) launchctl print "system/$1" >/dev/null 2>&1 || [[ -f "/Library/LaunchDaemons/$1.plist" ]] ;;
    rc)      service "$1" status >/dev/null 2>&1 || [[ -x "/usr/local/etc/rc.d/$1" ]] ;;
    openrc)  rc-service -e "$1" ;;
    sysv)    [[ -x "/etc/init.d/$1" ]] ;;
    *) return 1 ;;
  esac
}
svc_active() {
  case "$SM" in
    systemd) systemctl is-active --quiet "$1" ;;
    launchd) launchctl print "system/$1" 2>/dev/null | grep -q 'state = running' ;;
    rc)      service "$1" status >/dev/null 2>&1 ;;
    openrc)  rc-service "$1" status >/dev/null 2>&1 ;;
    sysv)    "/etc/init.d/$1" status >/dev/null 2>&1 ;;
    *) return 1 ;;
  esac
}
# 9>&- : a daemon started by the service manager must not inherit the helper lock.
svc_restart() {
  case "$SM" in
    systemd) systemctl restart "$1" 9>&- ;;
    launchd) launchctl kickstart -k "system/$1" 9>&- ;;
    rc)      service "$1" restart 9>&- ;;
    openrc)  rc-service "$1" restart 9>&- ;;
    sysv)    "/etc/init.d/$1" restart 9>&- ;;
    *) return 1 ;;
  esac
}

restart_services() {
  local restarted=false
  if svc_exists "$SERVICE"; then
    log "restarting $SERVICE ($SM)"
    svc_restart "$SERVICE" && restarted=true
  else
    log "warning: service $SERVICE not found under $SM; not restarted"
  fi
  if svc_active "$GATEWAY_SERVICE"; then
    log "restarting $GATEWAY_SERVICE"
    svc_restart "$GATEWAY_SERVICE" || log "warning: $GATEWAY_SERVICE restart failed"
  fi
  printf '%s' "$restarted"
}

# ---------------------------------------------------------------- helpers
current_version() { "$BIN_DIR/fips" --version 2>/dev/null | head -n 1 || echo "unknown"; }
ensure_backups_dir() { mkdir -p "$BACKUPS_DIR"; chmod 0755 "$BACKUPS_DIR"; }
runs() { "$1" --version >/dev/null 2>&1; }   # portable "is this a working executable" (ELF or Mach-O)

do_backup() {
  ensure_backups_dir
  local ver id dir d
  ver=$(current_version | sed -E 's/^fips +//; s/[^A-Za-z0-9._-]+/_/g')
  id="$(date +%Y%m%d-%H%M%S)_${ver:-unknown}"
  dir="$BACKUPS_DIR/$id"
  local i=1; while [[ -e "$dir" ]]; do i=$((i + 1)); dir="$BACKUPS_DIR/${id}-$i"; done; id=$(basename "$dir")
  mkdir -p "$dir"
  for b in "${BINARIES[@]}"; do
    [[ -f "$BIN_DIR/$b" ]] && cp -p "$BIN_DIR/$b" "$dir/$b"
  done
  current_version > "$dir/VERSION"
  chmod -R a+rX "$dir"
  log "backed up current binaries to $dir"
  # keep the 10 most recent backups (portable: no xargs -r)
  local n=0
  for d in $(ls -1dt "$BACKUPS_DIR"/*/ 2>/dev/null); do
    n=$((n + 1)); [[ $n -gt 10 ]] && rm -rf -- "$d"
  done
  printf '%s' "$id"
}

install_binaries() {
  local src=$1 installed=() f
  for b in "${BINARIES[@]}"; do
    f="$src/$b"
    [[ -e "$f" ]] || continue
    [[ -L "$f" ]] && die "refusing symlink $f"
    [[ -f "$f" ]] || die "$f is not a regular file"
    runs "$f" || die "$f does not execute (--version failed)"
    if [[ $(id -u) -eq 0 ]]; then install -m 0755 -o 0 -g 0 "$f" "$BIN_DIR/.$b.new"; else install -m 0755 "$f" "$BIN_DIR/.$b.new"; fi
    mv -f "$BIN_DIR/.$b.new" "$BIN_DIR/$b"
    installed+=("$b")
  done
  [[ ${#installed[@]} -gt 0 ]] || die "nothing to install in $src"
  log "installed: ${installed[*]}"
}

install_package() {
  local pkg=$1
  case "$OS" in
    Darwin)  log "installer -pkg $pkg -target /"; installer -pkg "$pkg" -target / 9>&- ;;
    FreeBSD) log "pkg add -f $pkg"; pkg add -f "$pkg" 9>&- ;;
    *) die "package artifacts are not supported on $OS" ;;
  esac
}

# ---------------------------------------------------------------- node management (v3)
FIPS_CONFIG=/etc/fips/fips.yaml
FIPS_NFT=/etc/fips/fips.nft
DROPIN_DIR=/etc/fips/fips.d
# Fixed per OS and deliberately not derived from FIPS_UI_BACKUPS, which sudo forwards from the caller.
CONFIG_BACKUPS_DIR="$(dirname "$BACKUPS_DEFAULT")/config-backups"
LOCK_FILE=/var/run/fips-ui-helper.lock
MAX_CONFIG_BYTES=262144
MAX_DROPIN_BYTES=65536
# Keys whose values never leave this script, matched case-insensitively against the whole key.
SECRET_KEYS='nsec|control_auth|secret|secret_key|private_key|password|passphrase|token|api_key|auth_token|psk|preshared_key|mnemonic|seed'
# Test mode only (FIPS_UI_HELPER_TEST=1 is never forwarded by sudo, see deploy/sudoers.d/fips-ui): point the
# management verbs at scratch files so the whole flow can be exercised without touching /etc.
if [[ ${FIPS_UI_HELPER_TEST:-0} == 1 ]]; then
  FIPS_CONFIG=${FIPS_TEST_CONFIG:-$FIPS_CONFIG}; FIPS_NFT=${FIPS_TEST_NFT:-$FIPS_NFT}; DROPIN_DIR=${FIPS_TEST_DROPIN_DIR:-$DROPIN_DIR}
  CONFIG_BACKUPS_DIR=${FIPS_TEST_CONFIG_BACKUPS:-$CONFIG_BACKUPS_DIR}; LOCK_FILE=${FIPS_TEST_LOCK:-$LOCK_FILE}
fi

# One privileged change at a time, across every caller (UI, upgrade jobs, a second tab, a shell).
take_lock() {
  command -v flock >/dev/null 2>&1 || return 0
  exec 9>"$LOCK_FILE"
  flock -w 10 9 || die "another privileged operation is in progress"
}

# Secret redaction, fail-closed. fips keeps its secrets (node.identity.nsec, transports.tor.control_auth) as
# simple single-line mapping values, and that is the only form handled: `key: value` on one line, the value
# a plain or completely quoted scalar, not in a list item, followed by no continuation. The value becomes the
# placeholder `"<redacted #N>"`. If a secret key or an nsec1… literal appears in ANY other form anywhere in
# the file (flow collections, block scalars, tags, anchors, list items, values on following lines, comments),
# the file is not shown at all and the offending lines are named: it must then be edited from a shell.
#
#   redact:  print the file with placeholders, or print nothing and exit 3 with reasons on stderr.
#   restore: (original, new) each placeholder #N must sit under the same key and the same chain of ancestor
#            lines as in the original, and be used once; the original line is put back. Deleting a secret line
#            deletes the secret; moving or copying a placeholder is refused. Messages show only redacted text.
SECRETS_AWK='
function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
function indent(s,   i) { i = match(s, /[^ ]/); return i ? i - 1 : length(s) }
function blank(s) { return s ~ /^[ \t]*$/ }
function comment(s) { return s ~ /^[ \t]*#/ }
# Any mention of a secret key followed by a colon, anywhere on the line, or an nsec1 bech32 literal.
function mentions(s,   t) { t = tolower(s); return t ~ ("(^|[^a-z0-9_])[\"\047]?(" KEYS ")[\"\047]?[ \t]*:") || t ~ /nsec1[02-9ac-hj-np-z]/ }
# simple(line): "key: value" in a block mapping with a secret key and a simple one-line value. Sets S_KEY,
# S_KEYTEXT (as written), S_COL (key column).
function simple(s,   b, c, k, v) {
  if (s ~ /^[ \t]*-/) return 0
  b = s; sub(/^[ \t]+/, "", b)
  c = match(b, /:([ \t]|$)/); if (!c) return 0
  k = substr(b, 1, c - 1); if (k ~ /[][{},#&*!|>%@`]/) return 0
  S_KEYTEXT = k; S_KEY = tolower(trim(k)); gsub(/^["\047]|["\047]$/, "", S_KEY); S_KEY = trim(S_KEY)
  if (S_KEY !~ ("^(" KEYS ")$")) return 0
  S_COL = indent(s)
  v = trim(substr(b, c + 1))
  if (v == "") return 0
  if (v ~ /^"/) { if (v !~ /^"([^"\\]|\\.)*"[ \t]*(#.*)?$/) return 0 }
  else if (v ~ /^\047/) { if (v !~ /^\047([^\047]|\047\047)*\047[ \t]*(#.*)?$/) return 0 }
  else if (v ~ /^[-?:,\[\]{}#&*!|>%@`]/) return 0
  # Exactly one secret mention (the key itself) outside the value: the value, which is hidden whole, may say
  # anything inside its quotes, but a trailing comment may not mention a secret key or an nsec.
  t = v; gsub(/^"([^"\\]|\\.)*"|^\047([^\047]|\047\047)*\047/, "", t)
  if (index(t, "#")) { cm = substr(t, index(t, "#")); if (mentions(cm)) return 0 }
  return 1
}
function chain(ind,   i, r) { while (sp > 0 && pind[sp] >= ind) sp--; r = ""; for (i = 1; i <= sp; i++) r = r (i > 1 ? " > " : "") ptext[i]; return r }
function push(ind, t) { sp++; pind[sp] = ind; ptext[sp] = t }
function ph(id) { return "\"<redacted #" id ">\"" }
function refuse(msg) { printf "line %d: %s\n", FNR, msg > "/dev/stderr"; bad = 1 }

# The walker for redact mode and the first pass of restore.
function walk(s,   ind, ch) {
  if (after_col >= 0 && !blank(s) && !comment(s)) {
    # Deeper lines continue the value; for a key with an empty value a "- " item at the same column is its sequence.
    if (indent(s) > after_col || (after_kind == "empty" && indent(s) == after_col && s ~ /^[ \t]*-([ \t]|$)/)) refuse(after_kind == "empty" ? "a secret key whose value is on the following lines" : "a secret value that continues on the next line")
    after_col = -1
  }
  if (blank(s)) { emit(s); return }
  if (comment(s)) { if (mentions(s)) refuse("a comment that mentions a secret key or an nsec"); else emit(s); return }
  ind = indent(s); ch = chain(ind)
  if (mentions(s)) {
    if (simple(s)) {
      n++; record(n, s, ch)
      emit(substr(s, 1, S_COL) S_KEYTEXT ": " ph(n))
      push(ind, trim(S_KEYTEXT) ": " ph(n)); after_col = S_COL; after_kind = "value"; return
    }
    # A secret key with nothing after it is fine only if nothing is nested below it (a null value).
    b = s; sub(/^[ \t]+/, "", b)
    if (s !~ /^[ \t]*-/ && b ~ ("^[\"\047]?(" KEYS ")[\"\047]?[ \t]*:[ \t]*$") ) { emit(s); push(ind, trim(s)); after_col = ind; after_kind = "empty"; return }
    refuse("a secret in a form this editor does not redact (flow collection, block scalar, tag, anchor, list item or quoted multi-line value)")
    return
  }
  emit(s); push(ind, trim(s))
}
function emit(s) { if (MODE == "redact") out[++nout] = s }
function record(id, s, ch) { if (MODE == "restore") { otext[id] = s; okey[id] = S_KEY; ochain[id] = ch } }

BEGIN { sp = 0; after_col = -1; n = 0 }
MODE == "redact" { walk($0); next }
MODE == "restore" && FILENAME == ARGV[1] { walk($0); next }
MODE == "restore" && !second { if (bad) { print "the current file cannot be redacted, so it cannot be edited here" > "/dev/stderr"; exit 3 } sp = 0; second = 1 }
MODE == "restore" {
  if ($0 ~ /<redacted/) {
    if (!match($0, /"<redacted #[0-9]+>"/)) { refuse("a redaction placeholder in an unexpected form"); next }
    id = substr($0, RSTART + 12, RLENGTH - 14)
    b = $0; sub(/^[ \t]+/, "", b); c = match(b, /:([ \t]|$)/)
    if ($0 ~ /^[ \t]*-/ || !c || trim(substr(b, c + 1)) != ph(id)) { refuse("placeholder #" id " must be the whole value of a plain key: line"); next }
    k = tolower(trim(substr(b, 1, c - 1))); gsub(/^["\047]|["\047]$/, "", k); k = trim(k)
    ind = indent($0); ch = chain(ind)
    if (!(id in otext)) { refuse("placeholder #" id " does not exist"); next }
    if (used[id]++) { refuse("placeholder #" id " is used twice"); next }
    if (k != okey[id] || ch != ochain[id]) { refuse("redacted secret #" id " (" okey[id] ") was moved; it belongs under: " (ochain[id] == "" ? "the top level" : ochain[id])); next }
    print otext[id]; push(ind, trim(substr(b, 1, c - 1)) ": " ph(id)); next
  }
  if (!blank($0) && !comment($0)) { chain(indent($0)); push(indent($0), trim($0)) }
  print
}
END {
  if (MODE == "redact" && !bad) for (i = 1; i <= nout; i++) print out[i]
  exit bad ? 3 : 0
}
'
redact() { awk -v MODE=redact -v KEYS="$SECRET_KEYS" "$SECRETS_AWK" "$1"; }
restore_secrets() { awk -v MODE=restore -v KEYS="$SECRET_KEYS" "$SECRETS_AWK" "$1" "$2" > "$3"; }

read_stdin_limited() { # <dest> <max-bytes>
  head -c "$(( $2 + 1 ))" > "$1"
  local n; n=$(wc -c < "$1" | tr -d ' ')
  (( n <= $2 )) || die "input larger than $2 bytes"
  (( n > 0 )) || die "empty input"
}

journal_tail_json() { # <unit> <since-epoch>
  local out; out=$(journalctl -u "$1" --since "@$2" -n 25 --no-pager -o cat 2>/dev/null || true)
  json_escape "$out"
}

fipsctl_bin() { [[ -x "$BIN_DIR/fipsctl" ]] && echo "$BIN_DIR/fipsctl" || echo fipsctl; }

# Healthy = the unit stays active without systemd restarting it, and the control socket (at the path the new
# config sets, if any) answers, for 8 consecutive seconds within a 45 s budget.
wait_fips_healthy() {
  local deadline=$(( $(date +%s) + 45 )) ok=0 restarts sock args=()
  # node.control.socket_path only (other sections, such as native_api, have their own socket_path).
  sock=$(awk '
    function ind(s) { match(s, /[^ ]/); return RSTART - 1 }
    /^[ \t]*(#.*)?$/ { next }
    { i = ind($0); while (sp > 0 && st[sp] >= i) sp--; k = $0; sub(/^[ \t]*/, "", k); sub(/[ \t]*:.*/, "", k)
      path = ""; for (j = 1; j <= sp; j++) path = path nm[j] "."; path = path k
      if (path == "node.control.socket_path") { v = $0; sub(/^[^:]*:[ \t]*/, "", v); sub(/[ \t]+#.*$/, "", v); gsub(/^["\047]|["\047]$/, "", v); print v; exit }
      sp++; st[sp] = i; nm[sp] = k }' "$FIPS_CONFIG" 2>/dev/null || true)
  [[ -n "$sock" && "$sock" == /* ]] && args=(-s "$sock")
  sleep 3
  restarts=$(systemctl show -p NRestarts --value "$SERVICE" 2>/dev/null || echo 0)
  while (( $(date +%s) < deadline )); do
    if systemctl is-active --quiet "$SERVICE" && [[ "$(systemctl show -p NRestarts --value "$SERVICE" 2>/dev/null || echo 0)" == "$restarts" ]] \
       && "$(fipsctl_bin)" "${args[@]}" show status >/dev/null 2>&1; then
      ok=$((ok + 1)); (( ok >= 8 )) && return 0
    else
      ok=0; restarts=$(systemctl show -p NRestarts --value "$SERVICE" 2>/dev/null || echo 0)
    fi
    sleep 1
  done
  return 1
}

require_systemd() { [[ "$SM" == systemd ]] || die "node management verbs need systemd (found $SM)"; }
valid_id() { [[ "$1" =~ ^[0-9]{8}-[0-9]{6}(-[0-9]+)?$ ]] || die "invalid backup id"; }

# backup_config [keep-id]: never prunes <keep-id> (the backup about to be restored).
backup_config() {
  mkdir -p "$CONFIG_BACKUPS_DIR"; chmod 0700 "$CONFIG_BACKUPS_DIR"
  local id; id=$(date +%Y%m%d-%H%M%S); local f="$CONFIG_BACKUPS_DIR/$id.yaml" i=1
  while [[ -e "$f" ]]; do i=$((i + 1)); f="$CONFIG_BACKUPS_DIR/$id-$i.yaml"; done
  install -m 0600 -o 0 -g 0 "$FIPS_CONFIG" "$f"
  local d n=0; for d in $(ls -1t "$CONFIG_BACKUPS_DIR"/*.yaml 2>/dev/null); do
    n=$((n + 1)); (( n > 20 )) && [[ "$(basename "$d" .yaml)" != "${1:-}" ]] && rm -f -- "$d"
  done
  basename "$f" .yaml
}

# install_config_and_restart <file> <backup-id> <restart:true|false>
# Signals are ignored from here on: a client that gives up must not interrupt an install or a rollback.
install_config_and_restart() {
  trap '' INT TERM HUP
  install -m 0600 -o 0 -g 0 "$1" "$FIPS_CONFIG"
  if [[ "$3" != true ]]; then printf '{"ok":true,"changed":true,"backup_id":%s,"restarted":false}\n' "$(json_escape "$2")"; return; fi
  local start; start=$(date +%s)
  systemctl restart "$SERVICE" || true
  if wait_fips_healthy; then
    printf '{"ok":true,"changed":true,"backup_id":%s,"restarted":true}\n' "$(json_escape "$2")"; return
  fi
  local log; log=$(journal_tail_json "$SERVICE" "$start")
  log "daemon unhealthy with the new config; restoring backup $2"
  install -m 0600 -o 0 -g 0 "$CONFIG_BACKUPS_DIR/$2.yaml" "$FIPS_CONFIG"
  systemctl restart "$SERVICE" || true
  local back=false; wait_fips_healthy && back=true
  printf '{"ok":false,"changed":false,"rolled_back":true,"backup_id":%s,"restored_healthy":%s,"error":"the daemon did not stay up with the new configuration","journal":%s}\n' "$(json_escape "$2")" "$back" "$log"
}

valid_dropin() { [[ "$1" =~ ^[a-z0-9][a-z0-9_-]{0,40}$ ]] || die "invalid drop-in name (a-z, 0-9, _ and -, up to 41 characters)"; }

# A drop-in is included inside the `inbound` chain, so it may only hold rule statements: no include/define
# (which could read other files), no table or chain commands, no `;`, and braces balanced on every line
# (so it cannot close the chain and act on the rest of the host's ruleset).
check_dropin_content() {
  awk '
    { line = $0; t = line; gsub(/"[^"]*"/, "\"\"", t); sub(/#.*/, "", t); gsub(/^[ \t]+|[ \t]+$/, "", t)
      if (t == "") next
      split(t, w, /[ \t]+/); first = tolower(w[1])
      if (first ~ /^(include|define|redefine|undefine|table|chain|flush|delete|add|create|insert|replace|reset|list|rename|monitor|export|import|describe|flowtable|destroy)$/) { printf "line %d: \"%s\" is not allowed in a drop-in\n", NR, w[1]; bad = 1; next }
      if (t ~ /[;$]/) { printf "line %d: \";\" and \"$\" are not allowed in a drop-in\n", NR; bad = 1; next }
      d = 0; for (i = 1; i <= length(t); i++) { ch = substr(t, i, 1); if (ch == "{") d++; else if (ch == "}") { d--; if (d < 0) break } }
      if (d != 0) { printf "line %d: braces must balance within the line\n", NR; bad = 1 }
    }
    END { exit bad }' "$1"
}

# check_ruleset <dir-with-candidate-dropins>: validate the baseline plus drop-ins without loading anything.
# Only nft's error summaries are returned (never the echoed source lines).
check_ruleset() {
  local t; t=$(mktemp -d); cp -a "$1/." "$t/" 2>/dev/null || true
  sed "s#include \"$DROPIN_DIR/\*\.nft\"#include \"$t/*.nft\"#" "$FIPS_NFT" > "$t/.baseline"
  grep -qF "include \"$t/*.nft\"" "$t/.baseline" || { rm -rf "$t"; printf '%s' "$FIPS_NFT does not contain the standard include \"$DROPIN_DIR/*.nft\" line; refusing to validate"; return 1; }
  local out; out=$(nft -c -f "$t/.baseline" 2>&1); local rc=$?
  rm -rf "$t"
  printf '%s' "$out" | grep -E 'Error:' | sed -E "s#^.*/([a-z0-9_-]+\.nft|\.baseline):#\1:#" | head -n 20
  return $rc
}

firewall_reload_if_active() {
  if systemctl is-active --quiet fips-firewall.service; then systemctl reload-or-restart fips-firewall.service && echo true || echo false; else echo false; fi
}

# ---------------------------------------------------------------- commands
cmd=${1:-}
case "$cmd" in
  check)
    ensure_backups_dir
    printf '{"ok":true,"version":%s,"os":%s,"service_manager":%s,"service":%s,"bin_dir":%s,"backups_dir":%s,"current":%s}\n' \
      "$HELPER_VERSION" "$(json_escape "$OS")" "$(json_escape "$SM")" "$(json_escape "$SERVICE")" \
      "$(json_escape "$BIN_DIR")" "$(json_escape "$BACKUPS_DIR")" "$(json_escape "$(current_version)")"
    ;;

  install)
    take_lock
    stage=${2:-}
    [[ -n "$stage" ]] || die "usage: install <stagedir> [--no-restart]"
    [[ "$stage" == /* ]] || die "stage dir must be an absolute path"
    [[ -d "$stage" ]] || die "stage dir $stage does not exist"
    no_restart=false; [[ "${3:-}" == "--no-restart" ]] && no_restart=true
    log "current: $(current_version)"
    backup_id=$(do_backup)
    if [[ -f "$stage/PACKAGE" ]]; then
      pkgfile="$stage/$(head -n 1 "$stage/PACKAGE")"
      [[ -f "$pkgfile" ]] || die "package file $pkgfile missing"
      install_package "$pkgfile"
      newver=$(current_version)
    else
      [[ -f "$stage/fips" ]] || die "$stage/fips missing"
      runs "$stage/fips" || die "staged fips does not run"
      newver=$("$stage/fips" --version 2>&1 | head -n 1)
      log "new:     $newver"
      install_binaries "$stage"
    fi
    restarted=false
    if ! $no_restart; then restarted=$(restart_services); fi
    printf '{"ok":true,"backup_id":%s,"installed_version":%s,"restarted":%s}\n' \
      "$(json_escape "$backup_id")" "$(json_escape "$newver")" "$restarted"
    ;;

  rollback)
    take_lock
    id=${2:-}
    [[ "$id" =~ ^[A-Za-z0-9._-]{1,80}$ ]] || die "invalid backup id"
    dir="$BACKUPS_DIR/$id"
    [[ -d "$dir" && -f "$dir/fips" ]] || die "backup $id not found"
    log "rolling back to $id ($(cat "$dir/VERSION" 2>/dev/null || echo '?'))"
    pre=$(do_backup)
    install_binaries "$dir"
    restarted=$(restart_services)
    printf '{"ok":true,"restored":%s,"pre_rollback_backup":%s,"restarted":%s}\n' \
      "$(json_escape "$id")" "$(json_escape "$pre")" "$restarted"
    ;;

  restart)
    take_lock
    restarted=$(restart_services)
    printf '{"ok":true,"restarted":%s}\n' "$restarted"
    ;;

  config-show)
    [[ -f "$FIPS_CONFIG" ]] || die "$FIPS_CONFIG not found"
    f="$FIPS_CONFIG"
    if [[ -n "${2:-}" ]]; then valid_id "$2"; f="$CONFIG_BACKUPS_DIR/$2.yaml"; [[ -f "$f" ]] || die "config backup $2 not found"; fi
    errf=$(mktemp); trap 'rm -f "$errf"' EXIT
    if ! out=$(redact "$f" 2>"$errf"); then
      die "cannot show this file safely: $(head -n 8 "$errf" | tr '\n' ';') edit it from a shell, or write secrets as single-line key: value"
    fi
    printf '%s\n' "$out"
    ;;

  config-apply)
    require_systemd; take_lock
    restart=true; [[ "${2:-}" == "--no-restart" ]] && restart=false
    [[ -f "$FIPS_CONFIG" ]] || die "$FIPS_CONFIG not found"
    tmp=$(mktemp); tmp2=$(mktemp); trap 'rm -f "$tmp" "$tmp2"' EXIT
    read_stdin_limited "$tmp" "$MAX_CONFIG_BYTES"
    if ! err=$(restore_secrets "$FIPS_CONFIG" "$tmp" "$tmp2" 2>&1); then die "$(printf '%s' "$err" | head -n 3 | tr '\n' ' ')"; fi
    grep -q '<redacted #' "$tmp2" && die "a redaction placeholder is still present"
    if cmp -s "$tmp2" "$FIPS_CONFIG"; then printf '{"ok":true,"changed":false,"restarted":false}\n'; exit 0; fi
    id=$(backup_config)
    install_config_and_restart "$tmp2" "$id" "$restart"
    ;;

  config-backups)
    mkdir -p "$CONFIG_BACKUPS_DIR"; chmod 0700 "$CONFIG_BACKUPS_DIR"
    printf '['; first=true
    for f in $(ls -1t "$CONFIG_BACKUPS_DIR"/*.yaml 2>/dev/null); do
      $first || printf ','; first=false
      printf '{"id":%s,"size":%s,"mtime":%s}' "$(json_escape "$(basename "$f" .yaml)")" "$(wc -c < "$f" | tr -d ' ')" "$(stat -c %Y "$f" 2>/dev/null || stat -f %m "$f")"
    done
    printf ']\n'
    ;;

  config-restore)
    require_systemd; take_lock
    valid_id "${2:-}"; f="$CONFIG_BACKUPS_DIR/$2.yaml"; [[ -f "$f" ]] || die "config backup $2 not found"
    tmp=$(mktemp); trap 'rm -f "$tmp"' EXIT; cp -p "$f" "$tmp"
    id=$(backup_config "$2")
    install_config_and_restart "$tmp" "$id" true
    ;;

  firewall-status)
    require_systemd
    active=false; systemctl is-active --quiet fips-firewall.service && active=true
    enabled=$(systemctl is-enabled fips-firewall.service 2>/dev/null || true)
    ruleset=null; loaded=false
    if command -v nft >/dev/null 2>&1 && out=$(nft -j list table inet fips 2>/dev/null) && [[ -n "$out" ]]; then ruleset=$out; loaded=true; fi
    printf '{"ok":true,"unit_active":%s,"unit_enabled":%s,"table_loaded":%s,"ruleset":%s}\n' "$active" "$(json_escape "${enabled:-unknown}")" "$loaded" "$ruleset"
    ;;

  dropin-apply)
    require_systemd; take_lock
    name=${2:-}; valid_dropin "$name"
    command -v nft >/dev/null 2>&1 || die "nft not found"
    [[ -f "$FIPS_NFT" ]] || die "$FIPS_NFT not found"
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    read_stdin_limited "$tmp/new" "$MAX_DROPIN_BYTES"
    if ! err=$(check_dropin_content "$tmp/new"); then printf '{"ok":false,"error":"the drop-in contains statements that are not allowed","detail":%s}\n' "$(json_escape "$err")"; exit 0; fi
    mkdir "$tmp/d"; cp -a "$DROPIN_DIR/." "$tmp/d/" 2>/dev/null || true; cp "$tmp/new" "$tmp/d/$name.nft"
    if ! err=$(check_ruleset "$tmp/d"); then printf '{"ok":false,"error":"nft rejected the ruleset","detail":%s}\n' "$(json_escape "$err")"; exit 0; fi
    mkdir -p "$DROPIN_DIR"
    install -m 0644 -o 0 -g 0 "$tmp/new" "$DROPIN_DIR/$name.nft"
    printf '{"ok":true,"file":%s,"reloaded":%s}\n' "$(json_escape "$DROPIN_DIR/$name.nft")" "$(firewall_reload_if_active)"
    ;;

  dropin-delete)
    require_systemd; take_lock
    name=${2:-}; valid_dropin "$name"
    [[ -f "$DROPIN_DIR/$name.nft" ]] || die "drop-in $name not found"
    rm -f -- "$DROPIN_DIR/$name.nft"
    printf '{"ok":true,"reloaded":%s}\n' "$(firewall_reload_if_active)"
    ;;

  service)
    require_systemd; take_lock
    trap '' INT TERM HUP
    action=${2:-}; unit=${3:-}
    case "$action" in start|stop|restart|reload|enable|disable) ;; *) die "action must be start, stop, restart, reload, enable or disable" ;; esac
    case "$unit" in fips|fips-firewall|fips-dns|fips-gateway) ;; *) die "unit must be fips, fips-firewall, fips-dns or fips-gateway" ;; esac
    systemctl cat "$unit.service" >/dev/null 2>&1 || die "$unit.service is not installed"
    if [[ "$action" == reload ]]; then systemctl reload-or-restart "$unit.service"; else systemctl "$action" "$unit.service"; fi
    a=false; systemctl is-active --quiet "$unit.service" && a=true
    printf '{"ok":true,"unit":%s,"active":%s,"enabled":%s}\n' "$(json_escape "$unit.service")" "$a" "$(json_escape "$(systemctl is-enabled "$unit.service" 2>/dev/null || true)")"
    ;;

  list-backups)
    ensure_backups_dir
    printf '['
    first=true
    for d in $(ls -1dt "$BACKUPS_DIR"/*/ 2>/dev/null); do
      id=$(basename "$d")
      $first || printf ','
      first=false
      printf '{"id":%s,"version":%s}' "$(json_escape "$id")" "$(json_escape "$(cat "$d/VERSION" 2>/dev/null || echo '')")"
    done
    printf ']\n'
    ;;

  *)
    die "usage: $0 {check|install <stagedir> [--no-restart]|rollback <id>|restart|list-backups|config-show [id]|config-apply [--no-restart]|config-backups|config-restore <id>|firewall-status|dropin-apply <name>|dropin-delete <name>|service <action> <unit>}"
    ;;
esac
